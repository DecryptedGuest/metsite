// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  // "native" covers local + Railway; the rhel targets are the Prisma query
  // engines Vercel's serverless (AWS Lambda) runtime needs. Harmless elsewhere.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  discordId       String    @unique
  discordUsername String
  displayName     String?
  discordAvatar   String?
  role            Role      @default(NONE) // no IA role unless one is actually resolved at login
  isBlacklisted   Boolean   @default(false)
  blacklistReason String?
  mustReauth      Boolean   @default(false)
  lastIp          String?
  lastRealIp      String? // most recent non-VPN IP seen for this account (dev panel only)
  lastRealIpAt    DateTime?
  robloxId        String?
  robloxUsername  String?
  notifyAsked     Boolean   @default(false)
  notifyEnabled   Boolean   @default(false)
  notifyPrefs     Json?
  lastRoleCheck   DateTime?
  createdAt       DateTime  @default(now())
  lastLogin       DateTime  @default(now())

  // In-flight WebAuthn challenge (registration or step-up authentication). Held
  // between the two ceremony round-trips; cleared once consumed.
  webauthnChallenge String?

  // Cached result of resolving this user's Discord roles against the
  // per-division role env vars, e.g. [{"division":"CID","rank":"LEAD"}].
  // Refreshed at login and by the same background revalidator that
  // refreshes `role`, so the division middleware never has to hit Discord
  // on the request path.
  divisions Json?

  // The user's MET-server Discord role IDs, captured at login. Used to decide
  // things gated on a specific Discord role (e.g. the HPC final-exam role).
  metRoleIds Json?

  // Developer-set, SITE-ONLY MET rank override: { name, rank }. When present it
  // is used as the user's MET rank site-wide (label + MET-HICOMM standing)
  // WITHOUT touching the Roblox group. Cleared by setting it null.
  metRankOverride Json?

  // The user's NATURAL (group-derived) MET rank { name, rank }, cached by the
  // access revalidator. Read-only reference so the dev panel can show it as the
  // "(default)" option in the MET-rank picker. Never used for gating (that's
  // metRankOverride / the live group lookup).
  metRankNatural Json?

  // Developer-set, SITE-ONLY panel grants: an ADDITIVE allow-list of extra
  // panels the user can access, on top of whatever their group ranks give. Each
  // entry is a token: "CID" | "CID:LEAD" | … | "IA" | "IA:SUPERVISOR" |
  // "IA:LEAD" | "MET" (MET High Command umbrella). Never removes group-derived
  // access; merged in during division resolution. Cleared by setting it null.
  panelGrant Json?

  // The user's rank inside the Internal Affairs Roblox group, snapshotted at
  // login and by the access revalidator. `role` collapses every investigator
  // tier into "IA", so this is what lets the site tell a Senior Investigator
  // apart from a Probationary one — the gate for SI+ actions (case appeals).
  iaRankName      String?
  iaRank          Int?

  hpcExamSubmissions HpcExamSubmission[]
  tryouts            Tryout[]
  tryoutLogs         TryoutLog[]
  sessions           Session[]
  passkeys           Passkey[]

  cases              Case[]
  caseActions        CaseAction[]
  caseAppeals        CaseAppeal[]
  caseDocuments      CaseDocument[]
  iaEventsHosted     IaEventLog[]     @relation("IaEventHost")
  pushSubscriptions  PushSubscription[]
  media              Media[]
  cidCases           CidCase[]
  sco19Deployments   Sco19Deployment[]
  flpShiftLogs       FlpShiftLog[]
  hpcTrainingRecords HpcTrainingRecord[]

  @@map("users")
}

model Visit {
  id              String   @id @default(uuid())
  path            String
  ip              String?
  userAgent       String?
  userId          String?
  discordId       String?
  discordUsername String?
  robloxId        String?
  robloxUsername  String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("visits")
}

model CaptureLog {
  id              String   @id @default(uuid())
  method          String
  details         String?
  page            String?
  os              String?
  browser         String?
  device          String?
  userAgent       String?
  screenInfo      String?
  language        String?
  screenshot      String?
  ip              String?
  userId          String?
  discordId       String?
  discordUsername String?
  robloxId        String?
  robloxUsername  String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("capture_logs")
}

model Case {
  id                          String     @id @default(uuid())
  caseRef                     String     @unique
  origin                      String     @default("NATIVE") // NATIVE | IA — IA sync never overwrites a NATIVE case
  userId                      String
  officerDiscordId            String?
  robloxUserId                String?
  robloxUsername              String?
  action                      String
  actions                     Json?
  reason                      String
  notes                       String     @default("N/A")
  caseLink                    String?
  investigatorRobloxId        String?
  investigatorRobloxUsername  String?
  investigatorDiscordUsername String?
  suspectRobloxDisplayName    String?
  punishmentsSummary          String?
  logMessageId                String?
  reviewNote                  String?
  reviewChanges               Json?
  // Snapshot of the case's editable fields taken the moment a reviewer requested
  // changes. Diffing this against the live row is what powers the "what actually
  // changed" view, so a reviewer can see exactly what the submitter updated.
  reviewSnapshot              Json?
  // Set when the submitter edits a case that had changes requested — records the
  // computed diff so the change history survives further edits.
  reviewRevisions             Json?
  // Exhibits captured from the linked case file when it was imported, as
  // [{ label, url, note }]. Stored rather than re-read, because reading them
  // means fetching somebody else's Google Doc on every panel open.
  evidence                    Json?
  // Retained for historical rows filed while case documents were written on the
  // site. Nothing writes it now; the case file is the linked document again.
  documentId                  String?
  // Appeal state. An appeal is auto-granted, so this is set at the moment it is
  // filed; the case's status moves to OVERTURNED and its punishments are lifted.
  appealedAt                  DateTime?
  appealedById                String?
  appealedByName              String?
  appealReason                String?
  status                      CaseStatus @default(PENDING)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  caseActions     CaseAction[]
  casePunishments CasePunishment[]
  appeals         CaseAppeal[]

  @@index([status])
  @@index([createdAt])
  @@map("cases")
}

// A granted appeal against an approved case. Appeals are approved automatically
// — filing one IS the decision — so this table is the permanent record of who
// overturned what, and why. Only Senior Investigator+ may file one at all, and
// only High Command may appeal a Termination or Blacklist.
model CaseAppeal {
  id            String   @id @default(uuid())
  caseId        String
  appealedById  String
  appealedByName String
  appealedByRank String?
  reason        String
  // The punishments that were lifted, snapshotted at appeal time.
  liftedActions Json?
  // True when the case carried a Termination/Blacklist (High-Command-only appeal).
  hicommOnly    Boolean  @default(false)
  createdAt     DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [appealedById], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@map("case_appeals")
}

// A case document built on the site — the replacement for the external Google
// Doc. `data` holds the structured fields (suspect, investigator, allegations,
// punishment checklist, exhibits) and `html` the rendered rich-text body, so the
// document can be re-opened in the editor AND rendered read-only at /case-doc/:id.
model CaseDocument {
  id        String   @id @default(uuid())
  docRef    String   @unique          // "DOC-0001"
  authorId  String
  caseId    String?                   // set once the document is attached to a case
  title     String
  status    String   @default("DRAFT") // DRAFT | FINAL
  data      Json                       // structured fields (see client/js/case-doc.js)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([caseId])
  @@map("case_documents")
}

// A closed ticket, ingested from the Tickety "Ticket Closed" log embeds in the
// IA ticket-logs Discord channel. Nobody logs a ticket by hand any more — the
// row arrives automatically — but a supervisor still approves or denies it on
// the site, and an approved log awards the closer 2 quota points.
model TicketLog {
  id                    String     @id @default(uuid())
  messageId             String     @unique   // Discord message id of the log embed
  channelId             String?
  // A short, readable number (#0001). Tickety's own id is a random string that
  // nobody can read in a table or say out loud; this is what the site shows.
  ticketNo              Int?       @unique
  ticketRef             String?              // Tickety's own ticket id
  ticketName            String?
  ticketType            TicketType @default(GENERAL_SUPPORT)
  reason                String?              // the close reason
  transcriptUrl         String?
  creatorDiscordId      String?
  creatorUsername       String?
  creatorRobloxUsername String?
  closerDiscordId       String?              // the "executor" — who closed it
  closerUsername        String?
  // Exactly what the log printed for the executor. closerUsername is resolved
  // from the id and can be null when that lookup fails; this never is, when the
  // message named anybody at all.
  closerRaw             String?
  closerUserId          String?              // matched site User.id → "My Tickets"
  closedAt              DateTime

  // Supervisor sign-off. Nobody logs a ticket by hand any more — the row is
  // ingested from Discord — but a supervisor still approves or denies it on the
  // site. Approval awards NO quota points.
  status                TicketStatus @default(PENDING)
  reviewedById          String?
  reviewedByName        String?
  reviewedAt            DateTime?
  // Set when the queue was reset: a log nobody is being asked to decide on any
  // more. Distinct from DENIED, which is a decision somebody made.
  voidedAt              DateTime?

  raw                   Json?
  createdAt             DateTime   @default(now())

  @@index([closedAt])
  @@index([closerDiscordId])
  @@index([closerUserId])
  @@index([ticketType])
  @@index([status])
  @@map("ticket_logs")
}

model CaseAction {
  id          String     @id @default(uuid())
  caseId      String
  actionType  ActionType
  performedBy String
  timestamp   DateTime   @default(now())
  notes       String?

  case Case @relation(fields: [caseId], references: [id])
  user User @relation(fields: [performedBy], references: [id])

  @@map("case_actions")
}

model CasePunishment {
  id           String    @id @default(uuid())
  caseId       String
  action       String
  roleId       String?
  durationDays Int?
  expiresAt    DateTime?
  roleRemoved  Boolean   @default(false)

  case Case @relation(fields: [caseId], references: [id])

  @@map("case_punishments")
}

model CaseCounter {
  id    Int @id @default(1)
  count Int @default(0)

  @@map("case_counter")
}

model AccessGrant {
  id        String   @id @default(uuid())
  discordId String   @unique
  role      Role     @default(IA)
  note      String?
  grantedBy String?
  createdAt DateTime @default(now())

  @@map("access_grants")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Permanently-hosted images/videos uploaded by IA members. Stored in the DB so
// they survive deploys (Railway's filesystem is ephemeral). Served via /media/:id.
model Media {
  id              String   @id @default(uuid())
  title           String?
  filename        String
  mimeType        String
  size            Int
  data            Bytes
  kind            String // 'image' | 'video'
  visibility      String   @default("IA") // PUBLIC | IA | STAFF | DEVELOPER
  uploaderId      String? // null for guest (anonymous) support-ticket uploads
  views           Int      @default(0)
  width           Int? // pixel dimensions (for video/image OG embeds)
  height          Int?
  poster          Bytes? // JPEG poster frame for videos (used as the embed thumbnail)
  posterMime      String? // e.g. 'image/jpeg'; presence signals a poster exists
  createdAt       DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id])

  @@index([createdAt])
  @@map("media")
}

// Durable outbox for quota point awards. Every approved case/ticket records an
// award here, and a background worker retries until the sheet write succeeds —
// so points are never lost to a transient webhook/RoVer failure or a spam burst.
model QuotaAward {
  id             String   @id @default(uuid())
  refType        String // 'case' | 'ticket'
  refId          String // case/ticket id — one award per ref (idempotent)
  discordId      String?
  robloxUsername String?
  points         Int
  label          String?
  division       String   @default("IA") // IA | FLP | MET — which sheet the worker writes to
  status         String   @default("PENDING") // PENDING | DONE | FAILED
  attempts       Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([refType, refId])
  @@index([status])
  @@map("quota_awards")
}

// An Internal Affairs event, logged on the site by whoever hosted it.
//
// Unlike PatrolLog — which mirrors what a bot read out of a Discord channel —
// this is filled in by a person on the dashboard, and submitting it IS the
// award: every attendee gets their quota points the moment it is filed. There
// is no approval step, so the record has to carry enough to audit it after the
// fact: who hosted, who attended, when, and what proof was offered.
model IaEventLog {
  id            String   @id @default(uuid())
  // Sequential, human-readable: "EVT-0042".
  eventRef      String   @unique
  eventType     String                      // Training | Briefing | Interview panel | …
  title         String?
  hostId        String                      // the site account that filed it
  hostDiscordId String?
  hostName      String?
  coHostName    String?
  startedAt     DateTime
  durationMins  Int?
  // [{ discordId, username, name, awarded }] — the roll, and what each was paid.
  attendees     Json
  attendeeCount Int      @default(0)
  pointsEach    Int      @default(2)
  // XP is paid alongside the quota points. It has no outbox of its own — it is
  // applied straight to the balance — so this is its receipt: who was given
  // what, and whether it landed. A withdrawal takes back exactly this.
  xpEach        Int      @default(0)
  xpAward       Json?
  notes         String?
  proof         Json?                       // links / screenshots offered as evidence it happened
  // Set when an event is withdrawn. The points already awarded are reversed by
  // their own award rows, so this is the record of the decision, not the undo.
  voidedAt      DateTime?
  voidedById    String?
  voidedReason  String?
  createdAt     DateTime @default(now())

  host User @relation("IaEventHost", fields: [hostId], references: [id])

  @@index([startedAt])
  @@index([hostId])
  @@map("ia_event_logs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

enum Role {
  NONE // no IA site role — division-only members / plain members; grants no IA access
  IA
  HICOMM
  SUPERVISOR
  DEVELOPER
}

enum CaseStatus {
  PENDING
  APPROVED
  DENIED
  // An approved case whose punishments were lifted on appeal. Kept as its own
  // status (rather than reverting to DENIED) so the record shows the case WAS
  // upheld and then overturned, and so it stops counting toward the officer's
  // punishment record.
  OVERTURNED
}

enum ActionType {
  CREATED
  APPROVED
  DENIED
  DELETED
  BLACKLISTED
  UNBLACKLISTED
  APPEALED
  CHANGES_REQUESTED
  CHANGES_APPLIED
}

enum TicketType {
  GENERAL_SUPPORT
  HICOMM
  OFFICER_REPORT
  APPEAL
}

enum TicketStatus {
  PENDING
  APPROVED
  DENIED
  // Ingested before the queue was reset. Not a decision anybody made — just no
  // longer anybody's to make. Still visible in All Tickets.
  VOID
}

// ─────────────────────────────────────────────────────────────────
// Multi-division dashboard — additive models. IA's own models above
// (Case, Ticket, ...) are untouched; each new division gets its own
// model(s) scoped by division rather than reusing/mutating Case.
// ─────────────────────────────────────────────────────────────────

enum Division {
  CID
  SCO19
  IA
  FLP
  HPC
}

// A user's rank within a single division, as resolved from Discord roles.
enum DivisionRank {
  MEMBER
  LEAD
}

// ── CID — Criminal Investigation Department ───────────────────────
enum CidCaseStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

model CidCase {
  id                 String        @id @default(uuid())
  caseRef            String        @unique
  title              String
  summary            String
  leadInvestigatorId String
  assignedIds        Json? // array of userIds assigned to the case
  status             CidCaseStatus @default(OPEN)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  leadInvestigator User           @relation(fields: [leadInvestigatorId], references: [id])
  entries          CidCaseEntry[]

  @@map("cid_cases")
}

// Evidence / notes log entries attached to a CID case.
model CidCaseEntry {
  id        String   @id @default(uuid())
  caseId    String
  authorId  String
  kind      String // 'note' | 'evidence'
  body      String
  createdAt DateTime @default(now())

  case CidCase @relation(fields: [caseId], references: [id])

  @@map("cid_case_entries")
}

// ── SCO-19 — Specialist Firearms Command ──────────────────────────
enum Sco19DeploymentStatus {
  PENDING_REVIEW
  SIGNED_OFF
  REJECTED
}

model Sco19Deployment {
  id            String                @id @default(uuid())
  deploymentRef String                @unique
  officerId     String
  callsign      String
  incidentType  String
  authorisation String // authorising officer / firearms authority reference
  summary       String
  status        Sco19DeploymentStatus @default(PENDING_REVIEW)
  signedOffById String?
  signedOffAt   DateTime?
  createdAt     DateTime              @default(now())

  officer User @relation(fields: [officerId], references: [id])

  @@map("sco19_deployments")
}

// ── FLP — Frontline Policing ───────────────────────────────────────
model FlpShiftLog {
  id             String    @id @default(uuid())
  officerId      String
  shiftStart     DateTime
  shiftEnd       DateTime?
  incidentsCount Int       @default(0)
  arrestsCount   Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  officer User @relation(fields: [officerId], references: [id])

  @@map("flp_shift_logs")
}

// ── HPC — Hendon Police College ────────────────────────────────────
enum HpcCadetStatus {
  ENROLLED
  IN_TRAINING
  PASSED
  FAILED
  GRADUATED
}

model HpcTrainingRecord {
  id             String         @id @default(uuid())
  cadetId        String
  courseName     String
  status         HpcCadetStatus @default(ENROLLED)
  instructorId   String?
  instructorNote String?
  signedOffAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  cadet User @relation(fields: [cadetId], references: [id])

  @@map("hpc_training_records")
}

// ─────────────────────────────────────────────────────────────────
// MET bot-populated data. The MET bot upserts these keyed by Discord
// id; the site joins them to the logged-in user by discordId. Kept in
// their own tables so the bot never needs the site's user ids and IA's
// User model stays untouched. All fields the bot writes are optional
// from the site's side — the profile page degrades gracefully until the
// bot fills them in.
// ─────────────────────────────────────────────────────────────────

// One row per MET member. `roles` and `perms` are rendered on the profile
// page as Discord-style chips.
model MetMemberProfile {
  id              String   @id @default(uuid())
  discordId       String   @unique
  discordUsername String?
  metNickname     String? // the member's nickname in the MET server
  robloxId        String?
  robloxUsername  String?
  // MET-server Discord roles: [{ id, name, color, position, icon }]
  roles           Json?
  // Dashboard / gang / multi-division perms shown as chips:
  //   [{ key, label, category, color }]
  perms           Json?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("met_member_profiles")
}

// A member's disciplinary history in the MET server (written by the bot).
model MetPunishment {
  id         String    @id @default(uuid())
  discordId  String // the punished member
  type       String // WARNING | STRIKE | SUSPENSION | BAN | DEMOTION | ...
  reason     String?
  issuedById String? // moderator discord id
  issuedBy   String? // moderator display name
  caseRef    String? // optional external reference
  active     Boolean   @default(true)
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([discordId])
  @@index([issuedAt])
  @@map("met_punishments")
}

// Audit trail for Discord moderation actions taken via the Dev Panel
// (server/routes/admin.js Discord Moderation tool). Purely a site-side log —
// Discord's own audit log already records the action; this lets the Dev Panel
// show "who did what, when" without needing Discord audit-log read access.
model DiscordModerationLog {
  id              String   @id @default(uuid())
  action          String // BAN | UNBAN | KICK | TIMEOUT | UNTIMEOUT
  targetDiscordId String
  targetUsername  String?
  reason          String?
  durationMinutes Int? // for TIMEOUT only
  performedById   String // the developer's User.id
  performedBy     String // the developer's display name, snapshotted
  createdAt       DateTime @default(now())

  @@index([targetDiscordId])
  @@index([createdAt])
  @@map("discord_moderation_log")
}

// A cadet's Metropolitan Police Final Examination attempt. Answers + the
// anti-cheat telemetry are stored on submit; a marker (HPC Database Manager+)
// later scores each question, and the result is posted to the MET results
// channel and shown on the cadet's own dashboard.
model HpcExamSubmission {
  id              String    @id @default(uuid())
  userId          String
  discordId       String
  discordUsername String?
  robloxUsername  String?
  answers         Json // { [questionId]: answerString }
  detection       Json? // raw anti-cheat telemetry from the exam page
  flags           Json? // computed [{ severity, code, label, detail }]
  aiScan          Json? // AI-detector results { at, scannedByName, providers, overall, perAnswer }
  status          String    @default("PENDING") // PENDING | PASSED | FAILED
  scores          Json? // { [questionId]: pointsAwarded } (set at marking)
  score           Int? // total awarded
  maxScore        Int // total possible at submit time
  percentage      Int? // computed at marking
  markerNote      String?
  markedById      String?
  markedByName    String?
  markedAt        DateTime?
  resultMessageId String? // Discord message id of the posted result
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("hpc_exam_submissions")
}

// A scheduled MET (HPC) tryout. Created by an HPC Junior Instructor+; when its
// scheduledAt is reached a background worker provisions a Roblox private server,
// DMs the host the details + link, and the host posts the announcement. British
// citizens can see upcoming/live tryouts and join the live one from the site.
model Tryout {
  id                String    @id @default(uuid())
  hostId            String // creator (User.id)
  hostDiscordId     String
  hostName          String
  hostRobloxId      String? // the host's Roblox id (for the in-game TryoutTV board)
  hostRobloxName    String? // the host's Roblox username
  coHostDiscordId   String?
  coHostName        String?
  scheduledAt       DateTime
  status            String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | CANCELLED
  division          String    @default("HPC") // HPC | CID — which tryout programme this belongs to
  lockState         String    @default("LOCKED") // LOCKED | UNLOCKED (game :serverlock state; legacy: SLOCKED/UNSLOCKED)
  privateServerLink String?
  privateServerId   String?
  accessCode        String? // reserved-server access code (for the Join launch-link flow)
  joinable          Boolean   @default(false) // host toggled "Allow players to join"
  hostLastSeenAt    DateTime? // last time the host was present in the tryout server (for the abandon-timeout auto-cancel)
  serverCreatedAt   DateTime?
  announcementSent  Boolean   @default(false)
  announcementMsgId String?
  scheduledEventId  String? // native Discord Scheduled Event id (deleted on cancel/complete)
  recruitmentMsgId  String? // optional CID recruitment cross-post message id
  hostDmMessageId   String?
  notes             String?
  suppressPings     Boolean   @default(false) // test mode: announce without pinging the role
  liveSnapshot      Json? // latest in-game overview while the tryout is live
  inGamePlayers     Json? // in-server roster at create/start, for the co-host picker
  summary           Json? // post-tryout summary card (counts + duration)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  host User @relation(fields: [hostId], references: [id])

  @@index([scheduledAt])
  @@index([status])
  @@index([division])
  @@map("tryouts")
}

// A management action the host/co-host issued from the SITE for a live tryout.
// The in-game panel polls GET /api/game/tryout/commands, applies each, then acks.
model TryoutCommand {
  id             String    @id @default(uuid())
  tryoutId       String
  action         String // STRIKE | UNSTRIKE | PASS | FAIL | KICK | NOTE
  division       String    @default("HPC")
  targetRobloxId String?
  targetUsername String?
  detail         String?
  issuedById     String?
  issuedByName   String?
  applied        Boolean   @default(false)
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([tryoutId, applied])
  @@map("tryout_commands")
}

// An FLP patrol log posted in the patrol-logs channel (PATROL_CHANNEL_ID). The
// bot captures + parses it, FLP reviews it on the site, and on approve/deny the
// bot reacts ✅/❌ to the original Discord message.
model PatrolLog {
  id                   String    @id @default(uuid())
  type                 String    @default("PATROL") // PATROL | EVENT
  messageId            String    @unique // Discord message id (react + idempotency)
  channelId            String
  pointAwarded         Boolean   @default(false) // EVENT logs: whether the MET point was written
  xpAwarded            Boolean   @default(false) // whether the XP award ran (separate conditions from the point)
  xpAward              Json? // what was awarded and to whom — the audit trail, and the idempotency record
  submitterDiscordId   String
  submitterUsername    String? // discord username
  submitterDisplayName String? // server nickname, e.g. "DEV | realangeloo"
  division             String? // parsed; shown as "N/A" when absent
  shiftStart           String? // 24h "HH:MM" as stated on the log
  shiftEnd             String? // 24h "HH:MM"
  totalMinutes         Int? // computed from start→end
  logDate              DateTime? // the shift's date: parsed from the log if present, else the message-sent date
  crossedMidnight      Boolean   @default(false) // shift ran past 00:00 (started the previous night)
  images               Json? // attachment image URLs
  eventMeta            Json? // EVENT logs: parsed + Discord-resolved { eventType, rank, host, coHost, attendees[], notesText, noteMembers[] }
  rawContent           String?
  status               String    @default("PENDING") // PENDING | APPROVED | DENIED
  reviewedById         String?
  reviewedByName       String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("patrol_logs")
}

// A concluded MET (HPC) tryout, logged by the host for review. The in-game
// HPCInstructorPanel sends a snapshot on conclusion (attendees, strikes, who
// left / got kicked, pass/fail results); the host reviews + posts it on the
// site (DRAFT → PENDING); HPC HICOMM approve/deny it; on approval the host is
// awarded 1 point on the HPC database.
model TryoutLog {
  id             String    @id @default(uuid())
  gameSessionId  String?   @unique // idempotency key from the game (one log per tryout session)
  tryoutId       String? // optional link to the scheduled Tryout
  hostId         String? // host (User.id) — null when the in-game host has no linked site account
  hostDiscordId  String?
  hostName       String
  hostRobloxId   String?
  hostRobloxName String?
  coHostName     String?
  coHostRobloxId String?
  startedAt      DateTime?
  concludedAt    DateTime? // when the host confirmed conclusion in-game
  // Per-attendee rows: [{ robloxId, username, joinedAt, leftAt, kicked,
  //   result: 'PASS'|'FAIL'|'PENDING', strikes: int, note }]
  attendees      Json?
  // Chronological event feed: [{ at, type: 'JOIN'|'LEAVE'|'KICK'|'STRIKE'|'PASS'|'FAIL'|'NOTE', username, by, detail }]
  events         Json?
  // Denormalised counts for quick listing.
  totalAttendees Int       @default(0)
  passedCount    Int       @default(0)
  failedCount    Int       @default(0)
  leftCount      Int       @default(0)
  kickedCount    Int       @default(0)
  strikeCount    Int       @default(0)
  notes          String? // host's write-up added on the site before posting
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | DENIED
  division       String    @default("HPC") // HPC | CID
  reviewNote     String? // HICOMM note on approve/deny
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  pointAwarded   Boolean   @default(false) // whether the +1 HPC point was written
  logMessageId   String? // Discord message id of the posted tryout log
  proof          String? // proof link/notes (the "Proof:" line), added by the host on review
  gamePayload    Json? // raw snapshot from the game (audit)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  host User? @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([division])
  @@index([createdAt])
  @@map("tryout_logs")
}

// Immutable action trail — every privileged / security-sensitive action across
// the site, for the MET HICOMM + Dev oversight dashboards. Append-only. This is
// the unified model (merges the HICOMM oversight trail with the security trail).
model AuditLog {
  id         String   @id @default(uuid())
  category   String // GROUP | SUPPORT | TRYOUT | CASE | TICKET | ACCESS | DEV | exam | auth | admin | moderation | SECURITY
  action     String // RANK_CHANGE | KICK | BLACKLIST | CLOSE | DELETE | APPROVE | SESSION_REVOKE …
  actorId    String?
  actorName  String?
  actorRole  String?
  targetType String?
  targetId   String?
  targetName String?
  division   String?
  summary    String?
  metadata   Json?
  ip         String?
  hash       String? // per-row HMAC over the row's fields — tamper-evidence
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_log")
}

// ── Alternative sign-in challenges ("try another way") ───────────────
// Backs the passwordless login options: a 6-digit code DM'd via the bot, and a
// QR approved from a logged-in device. Short-lived + single-use.
model LoginChallenge {
  id         String   @id @default(uuid())
  method     String // CODE | QR
  code       String? // 6-digit code (CODE method)
  discordId  String? // DM target (CODE method)
  userId     String? // resolved account (CODE: at request; QR: at approval)
  status     String   @default("PENDING") // PENDING | APPROVED | CONSUMED
  attempts   Int      @default(0)
  ip         String?
  userAgent  String? // QR: the initiating device, shown to the approver for context
  matchCode  String? // QR: 2-digit number-match code the approver must confirm
  secretHash String? // QR: sha256 of the initiator secret (binds status polling)
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([status])
  @@index([expiresAt])
  @@map("login_challenges")
}

// ── In-game log ingest (training/tryout game) ────────────────────────
// Adonis admin logs, join/leave and chat logs POSTed from the Roblox training
// game (see /api/game/log). Append-only; viewable by MET HICOMM on the site.
model GameLog {
  id        String   @id @default(uuid())
  source    String // ADONIS | JOIN | LEAVE | CHAT
  actor     String? // who did it (Roblox username/id)
  actorId   String? // Roblox user id, when the game sends it
  target    String? // who it was done to (for admin actions)
  action    String? // e.g. Kick | Ban | Warn (Adonis command), null for join/leave/chat
  message   String? // chat text / admin reason / free text
  place     String? // place/server label the game sends
  raw       Json? // full original payload for audit
  createdAt DateTime @default(now())

  @@index([source])
  @@index([actorId])
  @@index([createdAt])
  @@map("game_logs")
}

// ── Leave of Absence requests ────────────────────────────────────────
// Any MET member requests an LOA for a division or MET-wide; it forwards to the
// divisional HICOMM (division scope) or MET HICOMM (MET scope) for review.
// Leave of absence. Requested, reviewed and managed entirely through /loa in
// Discord — there is no page for it, because the people who need it are in
// Discord and the people who approve it are in Discord.
//
// `userId` is nullable: somebody who has never signed in to the dashboard can
// still ask for leave, and `discordId` is what actually identifies a requester.
model LoaRequest {
  id           String    @id @default(uuid())
  userId       String? // requester's site account, when they have one
  userName     String? // snapshot for listing
  // Who they are in Discord. This is the identity the command works from —
  // every subcommand resolves a person by it.
  discordId       String?
  discordUsername String?
  scope        String    @default("DIVISION") // MET | DIVISION
  division     String? // set when scope=DIVISION
  reason       String?
  startAt      DateTime
  endAt        DateTime
  status       String    @default("PENDING") // PENDING | APPROVED | DENIED | CANCELLED | ENDED | EXPIRED
  forwardedTo  String? // human label of the reviewing tier (e.g. "Jade Command")
  reviewerId   String?
  reviewerName String?
  reviewNote   String?
  reviewedAt   DateTime?

  // The request card posted for review, so a decision can edit it in place
  // instead of leaving a stale "pending" message in the channel.
  messageId    String?
  channelId    String?

  // Ended before its end date — by the member coming back early, or by command.
  endedAt      DateTime?
  endedById    String?
  endedByName  String?

  // A change the member has asked for on an approved leave:
  // { kind: 'EXTEND' | 'REDUCE', endAt, reason, at }. Held here rather than as
  // a second request so one leave stays one row.
  changeRequest Json?

  // Set when the end date passed and the leave was closed off automatically,
  // so a sweep cannot close the same one twice.
  expiredAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([discordId])
  @@index([status])
  @@index([division])
  @@index([endAt])
  @@map("loa_requests")
}

// ── Rank change history ──────────────────────────────────────────────
// Promotions/demotions ingested from the Discord promotions channel (or written
// by site actions). Feeds each member's rank timeline + the roster.
model RankHistory {
  id         String   @id @default(uuid())
  userId     String? // resolved site user, when known
  robloxId   String?
  discordId  String?
  memberName String? // who was promoted/demoted (display)
  group      String   @default("MET") // MET | CID | SCO19 | FLP | HPC
  fromRank   String?
  toRank     String?
  reason     String?
  byName     String? // who issued it
  source     String   @default("DISCORD") // DISCORD | MANUAL | SYNC
  messageId  String?  @unique // idempotency for Discord-ingested rows
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([robloxId])
  @@index([discordId])
  @@index([createdAt])
  @@map("rank_history")
}

// One-time, short-lived token for the "install on your phone" QR handoff: a
// signed-in user mints one, the phone opens /m/<token>, and we transfer the
// session to that device (single use, ~5 min TTL).
model MobileLoginToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("mobile_login_tokens")
}

// Four-eyes: a high-stakes action one developer proposes and a DIFFERENT
// developer must approve before it executes.
model PendingApproval {
  id              String    @id @default(uuid())
  action          String // LOCKDOWN | FORCE_REAUTH | BROADCAST
  params          Json?
  reason          String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById   String?
  requestedByName String?
  resolvedById    String?
  resolvedByName  String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@map("pending_approvals")
}

// Server-side login sessions — one per sign-in. The JWT carries this row's id
// (jti); requireAuth checks it exists and isn't revoked, giving instant
// revocation ("sign out everywhere") and an Active Sessions panel.
model Session {
  id         String    @id @default(uuid())
  userId     String
  ip         String?
  ipVpn      Boolean   @default(false) // was this session's IP flagged as a VPN/proxy/datacenter?
  ipOrg      String? // ISP / org / hosting provider behind the IP (dev panel only)
  userAgent  String?
  device     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  stepUpAt   DateTime? // last successful passkey step-up on this session

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// WebAuthn passkey / security key registered by a user, for passwordless
// step-up ("2FA"). Stores the credential id + public key + signature counter
// per the WebAuthn spec so authentication assertions can be verified.
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique // base64url credential ID
  publicKey    Bytes // COSE public key
  counter      BigInt    @default(0)
  transports   String? // JSON array e.g. ["internal","hybrid"]
  deviceType   String? // singleDevice | multiDevice
  backedUp     Boolean   @default(false)
  name         String? // user-facing label ("MacBook Touch ID")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// ══════════════════════════════════════════════════════════════════════
// CAD — Metropolitan Police Computer-Aided Dispatch (radio dispatch system)
// A self-contained dispatch state machine driven by two interfaces: the dev
// dispatch console (web) and the Discord #radio channel (free text → intent
// parser). Voice (TTS) output is layered on top. All models prefixed `Cad`.
// ══════════════════════════════════════════════════════════════════════

enum CadUnitStatus {
  OFF_DUTY
  AVAILABLE
  EN_ROUTE
  ON_SCENE
  BUSY
  MEAL_BREAK
  URGENT_ASSISTANCE
}

enum CadGrade {
  I // Immediate / emergency
  S // Significant
  E // Extended / scheduled
  R // Referred / resolution without deployment
}

enum CadIncidentStatus {
  OPEN
  ASSIGNED
  ON_SCENE
  CLOSED
}

// A booked-on officer with a callsign. Linked to their MET site account when
// they book on from the dashboard; discordUserId lets the #radio parser match
// their messages. A callsign is unique while active.
model CadUnit {
  id                String        @id @default(uuid())
  callsign          String        @unique
  discordUserId     String?
  userId            String? // MET site account, when linked
  officerName       String
  status            CadUnitStatus @default(AVAILABLE)
  currentIncidentId String? // the incident this unit is currently attached to
  bookedOnAt        DateTime      @default(now())
  lastStatusAt      DateTime      @default(now())
  createdAt         DateTime      @default(now())

  @@index([status])
  @@index([discordUserId])
  @@map("cad_units")
}

// A CAD incident (job). cadRef is INC-YYYYMMDD-NNN, unique per day.
model CadIncident {
  id            String            @id @default(uuid())
  cadRef        String            @unique
  grade         CadGrade
  category      String
  location      String
  description   String
  status        CadIncidentStatus @default(OPEN)
  createdById   String?
  createdByName String?
  closedOutcome String?
  createdAt     DateTime          @default(now())
  closedAt      DateTime?

  logs CadIncidentLog[]

  @@index([status])
  @@index([grade])
  @@map("cad_incidents")
}

model CadIncidentLog {
  id         String   @id @default(uuid())
  incidentId String
  unitId     String?
  type       String // CREATED | ASSIGNED | STATUS | ON_SCENE | UPDATE | CLOSED | BACKUP | PNC | RADIO
  message    String
  createdAt  DateTime @default(now())

  incident CadIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("cad_incident_logs")
}

// PNC vehicle record (fictional roleplay data).
model CadVehicleRecord {
  id               String   @id @default(uuid())
  vrm              String   @unique
  make             String
  model            String
  colour           String
  registeredKeeper String
  taxStatus        String // Taxed | Untaxed | SORN
  motStatus        String // Valid | Expired | None
  insuranceStatus  String // Insured | Uninsured | Unknown
  markers          String[]
  stolen           Boolean  @default(false)

  @@map("cad_vehicle_records")
}

// PNC person record (fictional roleplay data).
model CadPersonRecord {
  id             String   @id @default(uuid())
  forename       String
  surname        String
  dob            String // stored as ISO date string for simplicity
  address        String
  warningMarkers String[]
  wanted         Boolean  @default(false)

  @@index([surname])
  @@map("cad_person_records")
}

// ── XP ────────────────────────────────────────────────────────────
// An officer's XP balance in the MET. One row per Discord member; the balance
// is the source of truth and every change that produced it is in XpEvent.
//
// Rank is derived from `xp` against the ladder in server/lib/xp.js rather than
// stored, so changing a threshold re-ranks everybody without a backfill.
// `promotedRank` is the last rank we actually promoted them TO, which is what
// stops the same promotion firing twice.
model MetXp {
  discordId      String   @id
  xp             Int      @default(0)
  robloxId       String?
  robloxUsername String?
  // The rank this system last promoted them to. Null until the first
  // XP-driven promotion — an officer who was already a Sergeant before any of
  // this existed is not "promoted" to Sergeant the first time they earn XP.
  promotedRank   String?
  promotedAt     DateTime?
  firstEarnedAt  DateTime?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([xp])
  @@map("met_xp")
}

// Every XP change, and every promotion it triggered. The audit trail behind the
// balance — this is what /xp reads for "recent activity" and what makes a
// mistaken award traceable to whoever made it.
model XpEvent {
  id         String   @id @default(uuid())
  discordId  String // who the XP belongs to
  kind       String // ADD | REMOVE | SET | PROMOTION
  delta      Int      @default(0) // signed change; 0 for a PROMOTION row
  before     Int      @default(0)
  after      Int      @default(0)
  reason     String?
  fromRank   String?
  toRank     String?
  issuedById String? // the Discord user who ran the command
  issuedBy   String? // their display name at the time
  messageId  String? // the XP-log message this produced
  createdAt  DateTime @default(now())

  @@index([discordId])
  @@index([createdAt])
  @@map("xp_events")
}

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // "native" covers local + Railway; the rhel targets are the Prisma query
  // engines Vercel's serverless (AWS Lambda) runtime needs. Harmless elsewhere.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  discordId       String   @unique
  discordUsername String
  displayName     String?
  discordAvatar   String?
  role            Role     @default(IA)
  isBlacklisted   Boolean  @default(false)
  blacklistReason String?
  mustReauth      Boolean  @default(false)
  lastIp          String?
  robloxId        String?
  robloxUsername  String?
  notifyAsked     Boolean  @default(false)
  notifyEnabled   Boolean  @default(false)
  notifyPrefs     Json?
  lastRoleCheck   DateTime?
  createdAt       DateTime @default(now())
  lastLogin       DateTime @default(now())

  // In-flight WebAuthn challenge (registration or step-up authentication). Held
  // between the two ceremony round-trips; cleared once consumed.
  webauthnChallenge String?

  // Cached result of resolving this user's Discord roles against the
  // per-division role env vars, e.g. [{"division":"CID","rank":"LEAD"}].
  // Refreshed at login and by the same background revalidator that
  // refreshes `role`, so the division middleware never has to hit Discord
  // on the request path.
  divisions       Json?

  // The user's MET-server Discord role IDs, captured at login. Used to decide
  // things gated on a specific Discord role (e.g. the HPC final-exam role).
  metRoleIds      Json?

  // The user's rank inside the Internal Affairs Roblox group, snapshotted at
  // login and by the access revalidator. `role` collapses every investigator
  // tier into "IA", so this is what lets the site tell a Senior Investigator
  // apart from a Probationary one — the gate for SI+ actions (case appeals).
  iaRankName      String?
  iaRank          Int?

  hpcExamSubmissions HpcExamSubmission[]
  tryouts            Tryout[]
  sessions           Session[]
  passkeys           Passkey[]

  cases              Case[]
  caseActions        CaseAction[]
  caseAppeals        CaseAppeal[]
  caseDocuments      CaseDocument[]
  pushSubscriptions   PushSubscription[]
  media               Media[]
  cidCases            CidCase[]
  sco19Deployments    Sco19Deployment[]
  flpShiftLogs        FlpShiftLog[]
  activityLogs        ActivityLog[]
  hpcTrainingRecords  HpcTrainingRecord[]

  @@map("users")
}

model Visit {
  id              String   @id @default(uuid())
  path            String
  ip              String?
  userAgent       String?
  userId          String?
  discordId       String?
  discordUsername String?
  robloxId        String?
  robloxUsername  String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("visits")
}

model CaptureLog {
  id              String   @id @default(uuid())
  method          String
  details         String?
  page            String?
  os              String?
  browser         String?
  device          String?
  userAgent       String?
  screenInfo      String?
  language        String?
  screenshot      String?
  ip              String?
  userId          String?
  discordId       String?
  discordUsername String?
  robloxId        String?
  robloxUsername  String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("capture_logs")
}

model Case {
  id               String     @id @default(uuid())
  caseRef          String     @unique
  userId           String
  officerDiscordId String?
  robloxUserId     String?
  robloxUsername   String?
  action           String
  actions          Json?
  reason           String
  notes            String     @default("N/A")
  caseLink                    String?
  investigatorRobloxId        String?
  investigatorRobloxUsername  String?
  investigatorDiscordUsername String?
  suspectRobloxDisplayName    String?
  punishmentsSummary          String?
  logMessageId                String?
  reviewNote                  String?
  reviewChanges               Json?
  // Snapshot of the case's editable fields taken the moment a reviewer requested
  // changes. Diffing this against the live row is what powers the "what actually
  // changed" view, so a reviewer can see exactly what the submitter updated.
  reviewSnapshot              Json?
  // Set when the submitter edits a case that had changes requested — records the
  // computed diff so the change history survives further edits.
  reviewRevisions             Json?
  // Built-in case document (replaces the external Google Doc link). caseLink is
  // still written for backwards compatibility and points at /case-doc/<id>.
  documentId                  String?
  // Appeal state. An appeal is auto-granted, so this is set at the moment it is
  // filed; the case's status moves to OVERTURNED and its punishments are lifted.
  appealedAt                  DateTime?
  appealedById                String?
  appealedByName              String?
  appealReason                String?
  status           CaseStatus @default(PENDING)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  caseActions     CaseAction[]
  casePunishments CasePunishment[]
  appeals         CaseAppeal[]

  @@index([status])
  @@index([createdAt])
  @@map("cases")
}

// A granted appeal against an approved case. Appeals are approved automatically
// — filing one IS the decision — so this table is the permanent record of who
// overturned what, and why. Only Senior Investigator+ may file one at all, and
// only High Command may appeal a Termination or Blacklist.
model CaseAppeal {
  id            String   @id @default(uuid())
  caseId        String
  appealedById  String
  appealedByName String
  appealedByRank String?
  reason        String
  // The punishments that were lifted, snapshotted at appeal time.
  liftedActions Json?
  // True when the case carried a Termination/Blacklist (High-Command-only appeal).
  hicommOnly    Boolean  @default(false)
  createdAt     DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [appealedById], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@map("case_appeals")
}

// A case document built on the site — the replacement for the external Google
// Doc. `data` holds the structured fields (suspect, investigator, allegations,
// punishment checklist, exhibits) and `html` the rendered rich-text body, so the
// document can be re-opened in the editor AND rendered read-only at /case-doc/:id.
model CaseDocument {
  id        String   @id @default(uuid())
  docRef    String   @unique          // "DOC-0001"
  authorId  String
  caseId    String?                   // set once the document is attached to a case
  title     String
  status    String   @default("DRAFT") // DRAFT | FINAL
  data      Json                       // structured fields (see client/js/case-doc.js)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([caseId])
  @@map("case_documents")
}

// A closed ticket, ingested from the Tickety "Ticket Closed" log embeds in the
// IA ticket-logs Discord channel. Read-only on the site: nobody logs tickets by
// hand any more, there is no pending/approved state, and no quota points are
// awarded for them.
model TicketLog {
  id                    String     @id @default(uuid())
  messageId             String     @unique   // Discord message id of the log embed
  channelId             String?
  ticketRef             String?              // Tickety's own ticket id
  ticketName            String?
  ticketType            TicketType @default(GENERAL_SUPPORT)
  reason                String?              // the close reason
  transcriptUrl         String?
  creatorDiscordId      String?
  creatorUsername       String?
  creatorRobloxUsername String?
  closerDiscordId       String?              // the "executor" — who closed it
  closerUsername        String?
  closerUserId          String?              // matched site User.id → "My Tickets"
  closedAt              DateTime
  raw                   Json?
  createdAt             DateTime   @default(now())

  @@index([closedAt])
  @@index([closerDiscordId])
  @@index([closerUserId])
  @@index([ticketType])
  @@map("ticket_logs")
}

// ── Patrol & event logs ────────────────────────────────────────────
// Officers log patrols and events in Discord, and a supervisor signs one off by
// reacting to it — a tick to approve, a cross to deny. This table mirrors those
// messages onto the site.
//
// The decision is read off the MESSAGE's reactions, not from who clicked what
// in our UI, so a log ticked or crossed by anybody — including someone who has
// never opened the site — still lands here as approved or denied.
enum ActivityLogKind {
  PATROL
  EVENT
}

enum ActivityLogStatus {
  PENDING
  APPROVED
  DENIED
}

model ActivityLog {
  id        String            @id @default(uuid())
  messageId String            @unique  // Discord message id of the log itself
  channelId String
  guildId   String?
  kind      ActivityLogKind
  status    ActivityLogStatus @default(PENDING)

  // Who filed it. officerId is set when the Discord author matches a site
  // account, which is what puts the log under "my logs".
  officerId             String?
  officerDiscordId      String?
  officerUsername       String?
  officerRobloxUsername String?

  content     String?   // the log text as posted
  attachments Json?     // proof image / video URLs from the message
  loggedAt    DateTime

  // Who signed it off, and how we found out. decisionSource is
  // 'DISCORD_REACTION' when the tick/cross came from Discord and 'SITE' when it
  // was taken here (in which case the bot mirrors the reaction back).
  decidedAt          DateTime?
  decidedByDiscordId String?
  decidedByName      String?
  decidedByUserId    String?
  decisionSource     String?

  // Live reaction tallies, bots and the author excluded. Kept so the site can
  // show "2 ticks, 1 cross" rather than only the resolved status.
  tickCount  Int @default(0)
  crossCount Int @default(0)

  raw       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officer User? @relation(fields: [officerId], references: [id])

  @@index([loggedAt])
  @@index([officerId])
  @@index([officerDiscordId])
  @@index([status])
  @@index([kind])
  @@map("activity_logs")
}

model CaseAction {
  id          String     @id @default(uuid())
  caseId      String
  actionType  ActionType
  performedBy String
  timestamp   DateTime   @default(now())
  notes       String?

  case Case @relation(fields: [caseId], references: [id])
  user User @relation(fields: [performedBy], references: [id])

  @@map("case_actions")
}

model CasePunishment {
  id           String    @id @default(uuid())
  caseId       String
  action       String
  roleId       String?
  durationDays Int?
  expiresAt    DateTime?
  roleRemoved  Boolean   @default(false)

  case Case @relation(fields: [caseId], references: [id])

  @@map("case_punishments")
}

model CaseCounter {
  id    Int @id @default(1)
  count Int @default(0)

  @@map("case_counter")
}

model AccessGrant {
  id        String   @id @default(uuid())
  discordId String   @unique
  role      Role     @default(IA)
  note      String?
  grantedBy String?
  createdAt DateTime @default(now())

  @@map("access_grants")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Permanently-hosted images/videos uploaded by IA members. Stored in the DB so
// they survive deploys (Railway's filesystem is ephemeral). Served via /media/:id.
model Media {
  id         String   @id @default(uuid())
  title      String?
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  kind       String   // 'image' | 'video'
  visibility String   @default("IA") // PUBLIC | IA | STAFF | DEVELOPER
  uploaderId String
  views      Int      @default(0)
  width      Int?     // pixel dimensions (for video/image OG embeds)
  height     Int?
  poster     Bytes?   // JPEG poster frame for videos (used as the embed thumbnail)
  posterMime String?  // e.g. 'image/jpeg'; presence signals a poster exists
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([createdAt])
  @@map("media")
}

// Durable outbox for quota point awards. Every approved case/ticket records an
// award here, and a background worker retries until the sheet write succeeds —
// so points are never lost to a transient webhook/RoVer failure or a spam burst.
model QuotaAward {
  id             String   @id @default(uuid())
  refType        String   // 'case' | 'ticket'
  refId          String   // case/ticket id — one award per ref (idempotent)
  discordId      String?
  robloxUsername String?
  points         Int
  label          String?
  status         String   @default("PENDING") // PENDING | DONE | FAILED
  attempts       Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([refType, refId])
  @@index([status])
  @@map("quota_awards")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

enum Role {
  IA
  HICOMM
  SUPERVISOR
  DEVELOPER
}

enum CaseStatus {
  PENDING
  APPROVED
  DENIED
  // An approved case whose punishments were lifted on appeal. Kept as its own
  // status (rather than reverting to DENIED) so the record shows the case WAS
  // upheld and then overturned, and so it stops counting toward the officer's
  // punishment record.
  OVERTURNED
}

enum ActionType {
  CREATED
  APPROVED
  DENIED
  DELETED
  BLACKLISTED
  UNBLACKLISTED
  APPEALED
  CHANGES_REQUESTED
  CHANGES_APPLIED
}

enum TicketType {
  GENERAL_SUPPORT
  HICOMM
  OFFICER_REPORT
  APPEAL
}

// ─────────────────────────────────────────────────────────────────
// Multi-division portal — additive models. IA's own models above
// (Case, Ticket, ...) are untouched; each new division gets its own
// model(s) scoped by division rather than reusing/mutating Case.
// ─────────────────────────────────────────────────────────────────

enum Division {
  CID
  SCO19
  IA
  FLP
  HPC
}

// A user's rank within a single division, as resolved from Discord roles.
enum DivisionRank {
  MEMBER
  LEAD
}

// ── CID — Criminal Investigation Department ───────────────────────
enum CidCaseStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

model CidCase {
  id             String        @id @default(uuid())
  caseRef        String        @unique
  title          String
  summary        String
  leadInvestigatorId String
  assignedIds    Json?         // array of userIds assigned to the case
  status         CidCaseStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  leadInvestigator User          @relation(fields: [leadInvestigatorId], references: [id])
  entries          CidCaseEntry[]

  @@map("cid_cases")
}

// Evidence / notes log entries attached to a CID case.
model CidCaseEntry {
  id        String   @id @default(uuid())
  caseId    String
  authorId  String
  kind       String  // 'note' | 'evidence'
  body      String
  createdAt DateTime @default(now())

  case CidCase @relation(fields: [caseId], references: [id])

  @@map("cid_case_entries")
}

// ── SCO-19 — Specialist Firearms Command ──────────────────────────
enum Sco19DeploymentStatus {
  PENDING_REVIEW
  SIGNED_OFF
  REJECTED
}

model Sco19Deployment {
  id             String                 @id @default(uuid())
  deploymentRef  String                 @unique
  officerId      String
  callsign       String
  incidentType   String
  authorisation  String                 // authorising officer / firearms authority reference
  summary        String
  status         Sco19DeploymentStatus  @default(PENDING_REVIEW)
  signedOffById  String?
  signedOffAt    DateTime?
  createdAt      DateTime               @default(now())

  officer User @relation(fields: [officerId], references: [id])

  @@map("sco19_deployments")
}

// ── FLP — Frontline Policing ───────────────────────────────────────
model FlpShiftLog {
  id             String    @id @default(uuid())
  officerId      String
  shiftStart     DateTime
  shiftEnd       DateTime?
  incidentsCount Int       @default(0)
  arrestsCount   Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  officer User @relation(fields: [officerId], references: [id])

  @@map("flp_shift_logs")
}

// ── HPC — Hendon Police College ────────────────────────────────────
enum HpcCadetStatus {
  ENROLLED
  IN_TRAINING
  PASSED
  FAILED
  GRADUATED
}

model HpcTrainingRecord {
  id              String         @id @default(uuid())
  cadetId         String
  courseName      String
  status          HpcCadetStatus @default(ENROLLED)
  instructorId    String?
  instructorNote  String?
  signedOffAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cadet User @relation(fields: [cadetId], references: [id])

  @@map("hpc_training_records")
}

// ─────────────────────────────────────────────────────────────────
// MET bot-populated data. The MET bot upserts these keyed by Discord
// id; the site joins them to the logged-in user by discordId. Kept in
// their own tables so the bot never needs the site's user ids and IA's
// User model stays untouched. All fields the bot writes are optional
// from the site's side — the profile page degrades gracefully until the
// bot fills them in.
// ─────────────────────────────────────────────────────────────────

// One row per MET member. `roles` and `perms` are rendered on the profile
// page as Discord-style chips.
model MetMemberProfile {
  id              String   @id @default(uuid())
  discordId       String   @unique
  discordUsername String?
  metNickname     String?          // the member's nickname in the MET server
  robloxId        String?
  robloxUsername  String?
  // MET-server Discord roles: [{ id, name, color, position, icon }]
  roles           Json?
  // Portal / gang / multi-division perms shown as chips:
  //   [{ key, label, category, color }]
  perms           Json?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("met_member_profiles")
}

// A member's disciplinary history in the MET server (written by the bot).
model MetPunishment {
  id         String    @id @default(uuid())
  discordId  String                       // the punished member
  type       String                       // WARNING | STRIKE | SUSPENSION | BAN | DEMOTION | ...
  reason     String?
  issuedById String?                       // moderator discord id
  issuedBy   String?                       // moderator display name
  caseRef    String?                       // optional external reference
  active     Boolean   @default(true)
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([discordId])
  @@index([issuedAt])
  @@map("met_punishments")
}

// Audit trail for Discord moderation actions taken via the Dev Panel
// (server/routes/admin.js Discord Moderation tool). Purely a site-side log —
// Discord's own audit log already records the action; this lets the Dev Panel
// show "who did what, when" without needing Discord audit-log read access.
model DiscordModerationLog {
  id              String   @id @default(uuid())
  action          String   // BAN | UNBAN | KICK | TIMEOUT | UNTIMEOUT
  targetDiscordId String
  targetUsername  String?
  reason          String?
  durationMinutes Int?     // for TIMEOUT only
  performedById   String   // the developer's User.id
  performedBy     String   // the developer's display name, snapshotted
  createdAt       DateTime @default(now())

  @@index([targetDiscordId])
  @@index([createdAt])
  @@map("discord_moderation_log")
}

// A cadet's Metropolitan Police Final Examination attempt. Answers + the
// anti-cheat telemetry are stored on submit; a marker (HPC Database Manager+)
// later scores each question, and the result is posted to the MET results
// channel and shown on the cadet's own dashboard.
model HpcExamSubmission {
  id              String    @id @default(uuid())
  userId          String
  discordId       String
  discordUsername String?
  robloxUsername  String?
  answers         Json      // { [questionId]: answerString }
  detection       Json?     // raw anti-cheat telemetry from the exam page
  flags           Json?     // computed [{ severity, code, label, detail }]
  status          String    @default("PENDING") // PENDING | PASSED | FAILED
  scores          Json?     // { [questionId]: pointsAwarded } (set at marking)
  score           Int?      // total awarded
  maxScore        Int       // total possible at submit time
  percentage      Int?      // computed at marking
  markerNote      String?
  markedById      String?
  markedByName    String?
  markedAt        DateTime?
  resultMessageId String?   // Discord message id of the posted result
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("hpc_exam_submissions")
}

// A scheduled MET (HPC) tryout. Created by an HPC Junior Instructor+; when its
// scheduledAt is reached a background worker provisions a Roblox private server,
// DMs the host the details + link, and the host posts the announcement. British
// citizens can see upcoming/live tryouts and join the live one from the site.
model Tryout {
  id                String    @id @default(uuid())
  hostId            String    // creator (User.id)
  hostDiscordId     String
  hostName          String
  coHostDiscordId   String?
  coHostName        String?
  scheduledAt       DateTime
  status            String    @default("SCHEDULED") // SCHEDULED | LIVE | COMPLETED | CANCELLED
  lockState         String    @default("SLOCKED")   // SLOCKED | UNSLOCKED (shift-lock)
  privateServerLink String?
  privateServerId   String?
  serverCreatedAt   DateTime?
  announcementSent  Boolean   @default(false)
  announcementMsgId String?
  hostDmMessageId   String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  host User @relation(fields: [hostId], references: [id])

  @@index([scheduledAt])
  @@index([status])
  @@map("tryouts")
}

// Server-side login sessions — one per sign-in. The JWT carries this row's id
// (jti); requireAuth checks it exists and isn't revoked, giving instant
// revocation ("sign out everywhere") and an Active Sessions panel.
model Session {
  id         String    @id @default(uuid())
  userId     String
  ip         String?
  userAgent  String?
  device     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  stepUpAt   DateTime? // last successful passkey step-up on this session

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// WebAuthn passkey / security key registered by a user, for passwordless
// step-up ("2FA"). Stores the credential id + public key + signature counter
// per the WebAuthn spec so authentication assertions can be verified.
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique   // base64url credential ID
  publicKey    Bytes                // COSE public key
  counter      BigInt    @default(0)
  transports   String?              // JSON array e.g. ["internal","hybrid"]
  deviceType   String?              // singleDevice | multiDevice
  backedUp     Boolean   @default(false)
  name         String?              // user-facing label ("MacBook Touch ID")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// Immutable audit trail of security-sensitive actions across the whole portal
// (exam marking, tryouts, access/role changes, session revocations, etc.).
model AuditLog {
  id            String   @id @default(uuid())
  action        String   // e.g. EXAM_MARK | TRYOUT_SCHEDULE | SESSION_REVOKE | ACCESS_GRANT
  category      String   // e.g. exam | tryout | auth | admin | moderation
  actorId       String?  // User.id who performed it
  actorName     String?
  targetType    String?  // e.g. user | exam | tryout
  targetId      String?
  summary       String?
  metadata      Json?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@map("audit_log")
}

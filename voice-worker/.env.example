# voice-worker/.env.example — copy to Fly.io secrets (see README.md)

# A SECOND Discord bot token. Two processes cannot share one gateway login, so
# create a second Discord application (or a second bot) and invite it to your
# server with the Connect + Speak permissions. This is NOT your main bot token.
VOICE_BOT_TOKEN=

# Shared secret. Set the SAME value here and on the Railway app as
# CAD_VOICE_WORKER_SECRET. The Railway app sends it in the X-Worker-Secret
# header; requests without it are rejected. Use a long random string.
WORKER_SECRET=

# ElevenLabs — the voice. Same key/voice as the main app.
ELEVENLABS_API_KEY=
# Optional overrides (defaults: Daniel en-GB dispatcher, turbo v2.5):
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional attention tone played before Grade I lines (path inside the container).
# CAD_ATTENTION_TONE_PATH=

# Port the HTTP API listens on (Fly maps 443/80 → this via fly.toml).
PORT=8080

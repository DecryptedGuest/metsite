# ── Core (required — the bot refuses to start without these) ────────
DISCORD_BOT_TOKEN=            # Developer Portal → Bot → Reset Token
DISCORD_CLIENT_ID=            # Developer Portal → General Information → Application ID
IA_GUILD_ID=                  # Internal Affairs server — cases, tickets, quota, LOA, sync
MET_GUILD_ID=                 # MET server — group admin commands, punishment roles, notices
# Commands are registered PER SERVER and never in both: IA tooling stays in IA,
# group administration stays in MET. Re-run `npm run deploy` after changing these.
DATABASE_URL=postgresql://user:password@localhost:5432/metadmin

# ── Permission tiers (Discord role ids) ────────────────────────────
ROLE_IA=                      # can file cases/tickets, /check-record, /xp check
ROLE_SUPERVISOR=              # can approve/deny — except Blacklist and Termination
ROLE_HICOMM=                  # can approve anything; /xp review|reset|exempt|iotw; /loa; /promote; /pendingjoin
DEVELOPER_DISCORD_ID=         # your user id — always full access
DEVELOPER_ROLE_ID=            # optional: a role that also grants full access

# ── Punishment roles (assigned on approval, removed when timed ones lapse) ──
ROLE_VERBAL_WARNING=
ROLE_WRITTEN_WARNING=
ROLE_ZT=                      # Zero Tolerance — timed
ROLE_SUSPENDED=               # Suspension — timed
ROLE_ACTIVITY_STRIKE=
ROLE_STRIKE_1=
ROLE_STRIKE_2=
ROLE_STRIKE_3=
ROLE_BLACKLIST=
# Demotion and Termination carry no Discord role — they act on Roblox only.

# ── IA review channels ─────────────────────────────────────────────
CASES_CHANNEL_ID=1537076390829101057
TICKETS_CHANNEL_ID=1537076390829101058
IA_REVIEWER_ROLE_ID=          # pinged when a case is posted for review

# ── MET server ─────────────────────────────────────────────────────
MET_NOTICES_CHANNEL_ID=       # approved cases are announced here; unset = no notice
                              # The subject is also DMed. A closed DM is not an error.

# ── CID server / in-game panels ────────────────────────────────────
CID_GUILD_ID=1438215998338760887          # CID Discord server
CID_INSTRUCTOR_ROLE_ID=1438282078356504686  # the role mirrored to the panel
CID_INSTRUCTOR_KEY=CID_Instructors        # DataStore key the game reads

# Roblox Open Cloud — how Discord reaches the game. Create at
# create.roblox.com → Creator Dashboard → Open Cloud → API Keys, with the
# "Data Store" permission for the universe below (read + write on that store).
ROBLOX_UNIVERSE_ID=           # Creator Dashboard → your experience → ⋯ → Copy Universe ID
ROBLOX_OPENCLOUD_KEY=
ROBLOX_DATASTORE_NAME=MET_Sync
ROBLOX_DATASTORE_SCOPE=global

# ── IA rank ladder ─────────────────────────────────────────────────
# Ranks are matched by ROLE NAME ("Supervisor", "IA-SPVR", "SPVR") — these are
# only needed if your role names differ from the ladder.
# Authority: SPVR+ reviews · ADIR+ strikes 2-3, Zero Tolerance, Suspension
#            DDIR+ demotion and all HR commands · DIR only termination/blacklist
IA_ROLE_PINV=                 # Probationary Investigator
IA_ROLE_JINV=                 # Junior Investigator
IA_ROLE_INV=                  # Investigator
IA_ROLE_SINV=                 # Senior Investigator
IA_ROLE_SPVR=                 # Supervisor
IA_ROLE_ADIR=                 # Assistant Director
IA_ROLE_DDIR=                 # Deputy Director  ← "HR" starts here
IA_ROLE_DIR=                  # Director

# ── Custom emoji ───────────────────────────────────────────────────
# Paste the full token: <:name:id> (or <a:name:id> for animated). Get one by
# typing \:name: in Discord and sending it. Anything left blank falls back to
# Unicode, so the bot works before these are uploaded.
EMOJI_APPROVE=
EMOJI_DENY=
EMOJI_PENDING=
EMOJI_WARNING=
EMOJI_DENIED_MARK=
EMOJI_CASE=
EMOJI_TICKET=
EMOJI_POINTS=
EMOJI_LOA=
EMOJI_EXEMPT=
EMOJI_RANK_UP=
EMOJI_RANK_DOWN=
EMOJI_EXILE=
EMOJI_BLACKLIST=
EMOJI_IOTW=
EMOJI_DM=
EMOJI_SYNC=
EMOJI_DB=
EMOJI_CLOCK=
EMOJI_GOLD=
EMOJI_SILVER=
EMOJI_BRONZE=
EMOJI_BULLET=
# Button emoji must be a raw emoji or id, NOT the <:name:id> token:
EMOJI_APPROVE_RAW=
# Spinner frames for loading animations — comma-separated, animate best with
# a set of custom emoji. Blank = a Unicode braille spinner.
EMOJI_SPINNER_FRAMES=

# ── Webhooks ───────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=          # #administrative-logs — the approved-case notice
QUOTA_RESULTS_WEBHOOK_URL=    # where /xp review posts (falls back to the above)
QUOTA_PING_ROLE_ID=           # optional: role pinged by the weekly review
SIGNATURE_ICON_URL=           # optional: the "Signed, Internal Affairs High Command" icon

# ── Roblox ─────────────────────────────────────────────────────────
ROBLOX_GROUP_ID=              # the MET group id
ROVER_API_KEY=                # RoVer registry key — without it, the rate-limited public API is used
ROBLOX_COOKIE=                # .ROBLOSECURITY of the bot's Roblox account (group writes only)
# That account needs: Remove Members (exile) and Manage lower-ranked member ranks
# (promote/demote), and its group rank must sit ABOVE everyone it acts on.

# ── Quota sheet ────────────────────────────────────────────────────
QUOTA_SHEET_ID=               # the spreadsheet id from its URL
QUOTA_SHEET_NAME=             # optional tab name; blank = the first tab
QUOTA_TIMEZONE=Europe/London  # decides which weekday column "today" is
QUOTA_WEBHOOK_URL=            # Apps Script /exec URL — the primary write path
QUOTA_WEBHOOK_SECRET=         # must match SECRET in scripts/quota-webhook.gs
GOOGLE_SERVICE_ACCOUNT_JSON=  # fallback path: the whole key JSON on one line
QUOTA_REDUCTION_ROLE_ID=      # IOTW role — lowers its holder's weekly target
QUOTA_REDUCTION_GUILD_ID=     # optional: defaults to DISCORD_GUILD_ID
QUOTA_REDUCTION_AMOUNT=10

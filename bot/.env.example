# ── Core (required — the bot refuses to start without these) ────────
DISCORD_BOT_TOKEN=            # Developer Portal → Bot → Reset Token
DISCORD_CLIENT_ID=            # Developer Portal → General Information → Application ID
DISCORD_GUILD_ID=             # The MET server id (right-click the server → Copy Server ID)
DATABASE_URL=postgresql://user:password@localhost:5432/metadmin

# ── Permission tiers (Discord role ids) ────────────────────────────
ROLE_IA=                      # can file cases/tickets, /check-record, /xp check
ROLE_SUPERVISOR=              # can approve/deny — except Blacklist and Termination
ROLE_HICOMM=                  # can approve anything; /xp review|reset|exempt|iotw; /loa; /promote; /pendingjoin
DEVELOPER_DISCORD_ID=         # your user id — always full access
DEVELOPER_ROLE_ID=            # optional: a role that also grants full access

# ── Punishment roles (assigned on approval, removed when timed ones lapse) ──
ROLE_VERBAL_WARNING=
ROLE_WRITTEN_WARNING=
ROLE_ZT=                      # Zero Tolerance — timed
ROLE_SUSPENDED=               # Suspension — timed
ROLE_ACTIVITY_STRIKE=
ROLE_STRIKE_1=
ROLE_STRIKE_2=
ROLE_STRIKE_3=
ROLE_BLACKLIST=
# Demotion and Termination carry no Discord role — they act on Roblox only.

# ── IA review channels ─────────────────────────────────────────────
CASES_CHANNEL_ID=1537076390829101057
TICKETS_CHANNEL_ID=1537076390829101058

# ── Webhooks ───────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=          # #administrative-logs — the approved-case notice
QUOTA_RESULTS_WEBHOOK_URL=    # where /xp review posts (falls back to the above)
QUOTA_PING_ROLE_ID=           # optional: role pinged by the weekly review
SIGNATURE_ICON_URL=           # optional: the "Signed, Internal Affairs High Command" icon

# ── Roblox ─────────────────────────────────────────────────────────
ROBLOX_GROUP_ID=              # the MET group id
ROVER_API_KEY=                # RoVer registry key — without it, the rate-limited public API is used
ROBLOX_COOKIE=                # .ROBLOSECURITY of the bot's Roblox account (group writes only)
# That account needs: Remove Members (exile) and Manage lower-ranked member ranks
# (promote/demote), and its group rank must sit ABOVE everyone it acts on.

# ── Quota sheet ────────────────────────────────────────────────────
QUOTA_SHEET_ID=               # the spreadsheet id from its URL
QUOTA_SHEET_NAME=             # optional tab name; blank = the first tab
QUOTA_TIMEZONE=Europe/London  # decides which weekday column "today" is
QUOTA_WEBHOOK_URL=            # Apps Script /exec URL — the primary write path
QUOTA_WEBHOOK_SECRET=         # must match SECRET in scripts/quota-webhook.gs
GOOGLE_SERVICE_ACCOUNT_JSON=  # fallback path: the whole key JSON on one line
QUOTA_REDUCTION_ROLE_ID=      # IOTW role — lowers its holder's weekly target
QUOTA_REDUCTION_GUILD_ID=     # optional: defaults to DISCORD_GUILD_ID
QUOTA_REDUCTION_AMOUNT=10

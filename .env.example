# .env.example — copy to .env and fill in real values. Never commit .env.

# ── Core ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/metsite
JWT_SECRET=generate_a_long_random_string_here   # REQUIRED, min 32 chars — boot fails in production if unset/weak
PUBLIC_BASE_URL=                       # e.g. https://met.example.uk (forces a fixed OAuth callback base)
CANONICAL_HOST=                        # e.g. met.example.uk — redirects other hosts to this one
MOBILE_APP_URL=                        # download link for the MET mobile app (advertised to desktop users)

# Skip the always-on Discord bot + background workers (access revalidator,
# quota outbox). Auto-skipped on serverless (Vercel sets VERCEL=1); set this to
# 'true' to force-skip on any host, e.g. a web-only instance whose bot/workers
# run in a separate always-on process. Leave blank on Railway to run everything.
DISABLE_WORKERS=

# ── Discord OAuth2 (shared login for the whole dashboard) ──────────────
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_GUILD_ID=your_server_id
DISCORD_BOT_TOKEN=your_bot_token       # needs the Server Members intent

DEVELOPER_DISCORD_ID=                  # user id that always gets DEVELOPER + every division at LEAD rank
DEVELOPER_ROLE_ID=                     # optional: a Discord role id that also grants DEVELOPER
DEVELOPER_ROLE_ID2=

# ── Divisions (Roblox-group backed) ──────────────────────────────
# Membership + rank in each of the four new divisions comes ONLY from that
# division's Roblox GROUP ranks (via RoVer) — the same mechanism IA already
# uses. The account that HOLDS all the divisional groups (and whose group
# icons become the division icons) is set here; the dashboard auto-discovers each
# division's group by matching that account's groups by name, but you can pin
# a group id explicitly with the GROUP_* vars below (recommended for certainty).
DIVISION_HOLDER_USERNAME=FNTHOLDER_V2

# Explicit Roblox group ids per division. These defaults are the real MET group
# ids (baked into the code); override here only if they ever change.
GROUP_MET=17275620
GROUP_CID=12697126
GROUP_SCO19=14063116
GROUP_FLP=233530818
# FLP group rank at/above which a member gets the FLP Group Panel (manage the FLP
# Roblox group from /flp/dashboard). Default 170 = Assistant Director. The bot
# account (ROBLOX_COOKIE) must be in the FLP group with rank-management perms.
FLP_GROUP_ADMIN_MIN_RANK=170
# FLP patrol logs: the Discord channel where officers post shift/patrol logs. The
# bot reads new logs here (needs the Message Content intent, enabled in the
# Discord Developer Portal), FLP AD+ approve/deny them on the site, and the bot
# reacts ✅/❌ on the original message. The bot also needs "Add Reactions" perms
# in this channel. Leave blank to disable patrol-log capture.
#
# A log is signed off by SOMEBODY ticking or crossing it in Discord — whoever
# does it — and the site picks that up live (plus a reconcile sweep every 5
# minutes, so a sign-off made while the bot was down isn't lost). Setting either
# channel also turns on the GuildMessageReactions intent.
PATROL_CHANNEL_ID=
# Event logs: the Discord channel where officers post event-attendance logs.
# Captured like patrol logs, but APPROVING one adds +1 to the member's current-day
# cell on the MET database. Bot needs Message Content + Add Reactions here.
EVENTLOGS_CHANNEL_ID=
# Extra emoji that count as a tick / a cross on a patrol or event log, ADDED to
# the built-in sets (✅ ☑️ ✔️ 🟢 approve, ❌ ✖️ ❎ ⛔ 🚫 🔴 deny). Use a custom
# emoji's NAME (":signed:" → "signed") or its id. Comma-separated.
PATROL_APPROVE_EMOJI=
PATROL_DENY_EMOJI=
# The MET database spreadsheet (per-rank tabs: Chief Inspector / Inspector / …).
# On event-log approval the site searches every tab for the member's username and
# adds +1 to today's column. Uses the same Google creds as the quota sheet.
MET_SHEET_ID=1oWryixFS2U752CLrQ1OSwKNn8AwdtIgFliW9Q_8Cy3Q
GROUP_HPC=35685825

# ── HPC Final Examination ─────────────────────────────────────
# Discord role a cadet must hold to be required to sit the final exam.
HPC_EXAM_ROLE_ID=1509521712058990743
# Webhook on the MET final-exam results channel (1509522116590960640) — create
# a webhook there and paste its URL so marked results are posted automatically.
FINAL_EXAM_WEBHOOK=
HPC_RESULTS_WEBHOOK_URL=          # legacy fallback name for FINAL_EXAM_WEBHOOK

# ── MET Tryouts (HPC) ────────────────────────────────────────
# Role pinged in the tryout announcement.
TRYOUT_PING_ROLE_ID=1432426322059329567
# Discord channel the "Send Announcement" button posts the tryout to.
TRYOUT_ANNOUNCE_CHANNEL_ID=
# How the private server link is obtained when a tryout fires:
#   Simplest — a fixed reusable HPC tryout private-server link (create it once
#   in-game and paste it here). Leave blank to use dynamic creation (needs the
#   Roblox integration below).
TRYOUT_PRIVATE_SERVER_LINK=
# Roblox place id used for the tryout "Join" launch link. When a host presses
# "Allow players to join" in their DM, the announcement gains a link of the form
#   https://www.roblox.com/games/start?placeId=<this>&launchData=<{t,d}>
# The in-game router reads launchData, calls GET /api/game/tryout/joincode, and
# teleports the player into the reserved server. Same place for every division.
TRYOUT_JOIN_PLACE_ID=
# Minutes a tryout host can be absent from their server before the tryout is
# auto-cancelled (announcement pulled + host DMed). The host's in-game panel
# keeps the clock alive via live snapshots / serverlock / POST /tryout/heartbeat;
# it resets when they start/rejoin a tryout. Default 20.
TRYOUT_HOST_ABSENCE_MINUTES=20
# Discord role that lets "British citizens" see + join upcoming/live tryouts on
# the site. Leave blank to show tryouts to all signed-in users.
BRITISH_CITIZEN_ROLE_ID=
# Roles a discipline must NEVER remove. A blacklist takes somebody's MET rank
# and access; it is not a statement about who they are in the wider community,
# so it does not touch their verification or their citizenship.
#
# Verified, British Citizen and Citizen are kept by DEFAULT, matched by name
# with decoration ignored, so "✅ Verified" and "🇬🇧 British Citizen" both match
# without any id being configured. The match is exact on the normalised name,
# so a rank like "Verified Officer" is still removed.
#
# These two only ADD to that. Ids for anything the name match cannot see, and
# names for anything else you want kept.
# ── RoVer update server (optional) ──────────────────────────
# Self-hosted RoVer can expose an Update Server that re-runs a member's
# verification on demand, which fixes their roles AND their nickname from their
# Roblox group rank:
#
#   GET {ROVER_UPDATE_URL}/update-user?apiKey=…&id=<discord id>&guilds=a,b,c
#
# When these are set, an administrative action asks RoVer to do the work first,
# then CHECKS whether it actually happened and only does it itself if not. The
# endpoint answers "ok" before doing anything, so its reply is not evidence.
#
# Leave blank and nothing is lost: the bot sets the nickname directly instead.
# Role stripping for a blacklist always runs either way, because RoVer's sync
# is on its own schedule and the gap is a window where somebody just
# blacklisted still holds every permission they had.
ROVER_UPDATE_URL=
ROVER_UPDATE_KEY=

DISCIPLINE_KEEP_ROLE_IDS=
DISCIPLINE_KEEP_ROLE_NAMES=
# Shared secret the Hendon Police Campus game sends (header `x-game-secret`) when
# it reports the live server-lock state (Adonis :serverlock on/off). The site
# then updates the tryout's lock state and edits its Discord announcement in real
# time. Leave blank to disable the game callback (POST /api/game/serverlock).
TRYOUT_GAME_SECRET=

# ── Adonis command bridge ───────────────────────────────────
# NOTHING NEW TO SET. The bridge (POST /api/adonis/heartbeat, GET
# /api/adonis/commands/pending, and the rest) authenticates the game with the
# SAME secret as above: TRYOUT_GAME_SECRET, or GAME_SECRET if that is what you
# set. It deliberately does not introduce a second token.
#
# /adonis is registered in ONE server, hardcoded in server/lib/adonisCommand.js
# (GUILD_ID). It is not configurable and not in the global fallback set, because
# this command drives live game servers and it appearing anywhere else does real
# damage. Every entry point also refuses at runtime if it is invoked elsewhere.
#
# The Roblox side goes in docs/roblox/adonis-bridge.server.lua. Put the same
# value in a ServerStorage StringValue named MET_GAME_SECRET, and point
# BASE_URL at this site.
#
# Who may RUN a command is not an environment setting: it is High Command (or a
# developer), checked against the same rule the site uses everywhere else.
# Looking at servers and players needs only a normal signed-in session.

# ── HPC tryout logs ─────────────────────────────────────────
# When the host concludes a tryout in-game (HPCInstructorPanel), the game POSTs
# a snapshot to /api/game/tryout/conclude (same x-game-secret above). The host
# reviews + posts it on the site; HPC HICOMM approve/deny; on approval the host
# gets +1 point on the HPC database.
# Discord webhook on the HPC tryout-logs channel (submitted/approved/denied posts).
HPC_TRYOUT_LOG_WEBHOOK=
# The HPC database spreadsheet (the "1 point on approval" is written here to the
# host's current-day column, same layout as the IA quota sheet). Uses the same
# Google credentials as the quota sheet (GOOGLE_SERVICE_ACCOUNT_JSON, etc.).
HPC_SHEET_ID=1_5ioAdnq9UWxv_tTnwAoT7ygGD9kXtojKWyyDFuj7cA
HPC_SHEET_NAME=          # tab name; defaults to the first tab
# Optional "recruits" attendance sheet — on approval, each attendee's pass/fail
# is appended here (date, host, recruit, roblox id, result, strikes, kicked/left).
HPC_RECRUITS_SHEET_ID=
HPC_RECRUITS_SHEET_NAME=
# Optional HMAC signing for game callbacks (replay-resistant). If set, the game
# may send x-game-signature = hex(HMAC_SHA256(rawBody, this)) instead of the
# shared secret. Both are accepted, so you can adopt signing gradually.
TRYOUT_GAME_SIGNING_SECRET=
# Optional numeric-rank thresholds for HPC tiers (defaults match by rank name:
# Junior Instructor+ = access, Database Manager+ = mark, Assistant Director+ = quota).
HPC_INSTRUCTOR_MIN_RANK=
HPC_MARKER_MIN_RANK=
HPC_QUOTA_MIN_RANK=

# ── CID (Criminal Investigation Department) tryouts ───────────────────────────
# A parallel tryout programme to HPC, gated by two CID Discord roles instead of
# a Roblox group rank. The in-game CID panel/board call the SAME game endpoints
# as HPC but send division:"CID" (body) / ?division=CID (query). Data never mixes.
#
# Access (already set): the CID Discord server + the two roles that get access.
CID_GUILD_ID=                       # the CID Discord server (bot must be a member)
CID_INSTRUCTORUNIT_ROLE_ID=         # role → CID tryout access (Instructor Unit)
CID_DIRECTOROFFICE_ROLE_ID=         # role → CID access + LEAD (reviews tryout logs)
#
# Ban / punishment evasion alerts. A blacklisted or punished Roblox account that
# rejoins under a new Discord account is flagged to Internal Affairs.
IA_GUILD_ID=1424498408009240649            # the Internal Affairs Discord server
IA_ALERT_CHANNEL_ID=1534508917718126653    # where evasion alerts are posted
IA_PING_ROLE_ID=                           # optional role to ping on each alert
EVASION_ALERTS=                            # set to "off" to disable the scan
# Who may run /promote on top of the XP-management routes (default: HPC HICOMM).
PROMOTE_ROLE_IDS=1398071632207151184
#
# Announcements — the CID tryout channel + the two roles pinged at the bottom.
CID_TRYOUT_CHANNEL_ID=1456008353099677882
CID_TRYOUT_PING_ROLE_1=1438215998338760892
CID_TRYOUT_PING_ROLE_2=1438215998338760893
# (legacy fallback — comma-separated list, used only if the two above are unset)
CID_TRYOUT_PING_ROLE_IDS=
CID_EMOJI=<:CID:1438625241999085790>   # the :CID: custom emoji token (bare :CID: won't render)
# CID database spreadsheet (rank-tier tabs: LOW/MIDDLE/HIGH RANK). Used for the
# "events hosted/attended" write on tryout approval (Component 2 — pending wiring).
CID_SHEET_ID=1E4C8N-ezmD5cZYpFlHex-OvYZx0M_Z_xR6kQJSmyCSg
#
# Optional CID recruitment cross-post (longer format in a second channel). Leave
# CID_RECRUITMENT_CHANNEL_ID blank to skip the cross-post entirely.
CID_RECRUITMENT_CHANNEL_ID=         # MET recruitment channel (optional)
CID_RECRUITMENT_PING_ROLE_IDS=      # e.g. Recruitment Notifications,British Civilian
CID_RECRUITMENT_INVITE=https://discord.gg/PEV6H9suC6
CID_RECRUITMENT_INFO=               # the "Information:" block text (paste the CID doc block here)
#
# Optional: separate Discord webhook for CID tryout-log posts (submitted/approved/
# denied). Falls back to HPC_TRYOUT_LOG_WEBHOOK if unset.
CID_TRYOUT_LOG_WEBHOOK=

# LEAD tier threshold per division (provisional until each division's real rank
# ladder is defined): a member is treated as LEAD when their Roblox group rank
# number is >= this value. Defaults to 255 (owner only) when unset.
LEAD_MIN_RANK_CID=
LEAD_MIN_RANK_SCO19=
LEAD_MIN_RANK_FLP=
LEAD_MIN_RANK_HPC=

# ── MET permissions group + standing/disciplinary roles ─────────────
# The Roblox "permissions" group whose ranks map to a member's dashboard perms
# (QUOTA EXEMPT, GANG PERMS, MULTI DIVISION PERMS, the BUYER perms, the
# RANK-LOCK perms, …). Only ranks 2..99 are shown on the profile — Guest/Member
# and rank 100+ (MET ADMINISTRATION/HICOMM/Overseer/HOLDER) are their MET rank,
# not a perm. Read-only public Roblox API, so only the id is needed.
PERMS_GROUP_ID=381582724
# REQUIRED for multiple-roles-per-member (Roblox feature, live 2026-03): an Open
# Cloud API key with this group's membership READ scope. Without it the site uses
# the legacy endpoint which returns only ONE role per member, so members who hold
# several perm roles won't see them all. Create at create.roblox.com → Open Cloud
# → API Keys → add the "group:read"/memberships scope for group PERMS_GROUP_ID.
PERMS_GROUP_API_KEY=

# Disciplinary / standing Discord role IDs. If a member holds one it shows as a
# coloured flag chip on their profile (captured from their Discord roles at login).
ROLE_ACTIVITY_STRIKE=1219011548714893343
ROLE_STRIKE_1=1191048287361433738
ROLE_STRIKE_2=1191048287361433739
ROLE_STRIKE_3=1513101097978564739
ROLE_SUSPENDED=1429561201331015781
ROLE_WRITTEN_WARNING=1469746159961509999
# Verbal Warning is retired. It always pointed at the Written Warning role, so
# it reads the same id — old records still resolve to the role their holder
# actually wears.
ROLE_VERBAL_WARNING=1469746159961509999
ROLE_ZT=1452275521470726235

# IA — Internal Affairs (existing site-role pipeline, unchanged). IA division
# access is derived from the IA site role below, not from the GROUP_* vars.
ROLE_IA=1398071208343244870
ROLE_HICOMM=1399746451453644860
ROLE_SUPERVISOR=1424505342129082571

# ── IA-specific integrations (unchanged) ──────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
IA_GROUP_ID=407296071
# Main MET group for exile/demote/membership/nickname-sync. Leave blank to use
# GROUP_MET (above) automatically; only set this to override with a different group.
ROBLOX_GROUP_ID=
ROVER_API_KEY=
ROBLOX_COOKIE=

# ── Roblox asset uploads (dev panel → Roblox Audio) ───────────────
# The credential used to upload audio is NOT set here — it is pasted into the dev
# panel and stored encrypted in the database, because it belongs to a person
# rather than to the deployment. Nothing to configure for the feature itself.
#
# It is sealed with a key derived from JWT_SECRET, so JWT_SECRET must be set (it
# already is, above) and changing it invalidates the stored credential, which
# then has to be pasted again. Set SECRET_BOX_KEY to pin the encryption key
# independently, so JWT_SECRET can be rotated without that happening.
SECRET_BOX_KEY=

TICKET_LOG_GUILD_ID=
TICKET_LOG_CHANNEL_ID=
# How many past messages the FIRST ticket-log backfill reads (later sweeps stop
# as soon as they reach logs the site already has).
TICKET_LOG_BACKFILL=1500

# ── Internal Affairs quota ───────────────────────────────────────
# Weekly targets are per rank and live in code (quotaForRank): Low Command 30,
# Middle Command 20, Director/LOA exempt. Only the point VALUES are env-set:
# an approved case is worth 4 to its investigator, an approved ticket log 2 to
# whoever closed the ticket.
IA_CASE_POINTS=4
IA_TICKET_POINTS=2
# IA group rank number at/above which a member counts as Senior Investigator.
# Senior Investigator and above may file case appeals; only High Command may
# appeal a Termination or a Blacklist.
IA_SI_MIN_RANK=15

# ── IA quota (Internal Affairs — the original, UNPREFIXED vars) ──
QUOTA_SHEET_ID=
QUOTA_SHEET_NAME=
QUOTA_TIMEZONE=Europe/London
QUOTA_WEBHOOK_URL=
QUOTA_WEBHOOK_SECRET=
QUOTA_RESULTS_WEBHOOK_URL=
QUOTA_REDUCTION_GUILD_ID=
QUOTA_REDUCTION_ROLE_ID=
QUOTA_REDUCTION_AMOUNT=

# ── MET database sync ────────────────────────────────────────────
# Removes members who are no longer in the MET group from the database sheet
# and adds newly joined constables into the rows that frees up.
MET_DB_GROUP_ID=
MET_DB_JOIN_RANKS=Constable
MET_DB_MIN_RANK=
MET_DB_MAX_ADD=25
MET_DB_AUTO_SYNC=false
# Safety limit: refuse the sync if it would remove more than this share of the
# sheet (a bad group read shouldn't be able to empty the database).
MET_DB_MAX_REMOVE_SHARE=0.5

# MET umbrella group — the source of the "Rank" autofill on a case document.
MET_GROUP_ID=17275620

# ── Division-aware quota (FLP + MET) ─────────────────────────────
# The same quota engine now serves three divisions. IA keeps the unprefixed vars
# above; FLP and MET use the FLP_/MET_ prefixed vars below. Each division's
# webhook is a SEPARATE Apps Script deployment bound to that division's sheet
# (see scripts/quota-webhook.gs), each with its own unique secret.
#
# FLP sheet (the frontline quota sheet reviewed on the FLP dashboard):
FLP_SHEET_ID=
FLP_QUOTA_SHEET_NAME=          # tab name; blank = first tab
FLP_QUOTA_TIMEZONE=            # blank → falls back to QUOTA_TIMEZONE
FLP_QUOTA_WEBHOOK_URL=
FLP_QUOTA_WEBHOOK_SECRET=
FLP_QUOTA_RESULTS_WEBHOOK_URL= # Discord webhook the FLP quota review posts to
FLP_QUOTA_MENTION_ROLE_ID=     # optional role to ping on the FLP quota review
# Rank → weekly target. Either a JSON rule list (first match on the rank wins)…
#   FLP_QUOTA_TARGETS=[{"match":"director","exempt":true,"tier":"High Command"},{"match":"sergeant|inspector","target":20,"tier":"Supervisory"},{"match":".*","target":30,"tier":"Officer"}]
FLP_QUOTA_TARGETS=
# …or a single flat target for every non-exempt rank (with a tier label):
FLP_QUOTA_TARGET=              # e.g. 30
FLP_QUOTA_TIER=                # label for the flat target (default "Member")

# MET database sheet (per-rank tabs; MET_SHEET_ID is defined higher up):
MET_QUOTA_SHEET_NAME=          # tab name; blank = search every tab
MET_QUOTA_TIMEZONE=            # blank → falls back to QUOTA_TIMEZONE
MET_QUOTA_WEBHOOK_URL=
MET_QUOTA_WEBHOOK_SECRET=
MET_QUOTA_RESULTS_WEBHOOK_URL= # Discord webhook the MET quota review posts to
MET_QUOTA_MENTION_ROLE_ID=     # optional role to ping on the MET quota review
MET_QUOTA_TARGETS=             # JSON rule list, same shape as FLP_QUOTA_TARGETS
MET_QUOTA_TARGET=              # flat fallback target
MET_QUOTA_TIER=                # label for the flat target (default "Member")
# MET quota policy (used when MET_QUOTA_TARGETS/TARGET are blank):
#   Constable / Sergeant / Inspector / Chief Inspector → MET_QUOTA_EVENTS a
#   week, division or not. One point on the MET database is one event.
#   Community Support Officers and everyone above Chief Inspector are exempt.
#   The only thing that lifts it for a tracked rank is the bought Quota Exempt
#   Discord role (QUOTA_EXEMPT_ROLE_ID, further down).
MET_QUOTA_EVENTS=              # weekly event target (default 3)

# ── FLP High Command gate (quota tabs + event-log approval) ──────
# A user is FLP HICOMM if DEVELOPER / MET HICOMM, OR their FLP group rank ≥
# FLP_HICOMM_MIN_RANK (when set), OR they hold Discord role FLP_HICOMM_ROLE_ID
# (when set). If NEITHER is set, it falls back to FLP_GROUP_ADMIN_MIN_RANK
# (Assistant Director+). Gates the FLP quota routes AND event-log approval.
FLP_HICOMM_MIN_RANK=
FLP_HICOMM_ROLE_ID=
FLP_HICOMM_GUILD_ID=          # guild to read FLP_HICOMM_ROLE_ID from; blank → MET_GUILD_ID/DISCORD_GUILD_ID

# Where an approved EVENT log's +1 point lands: FLP (default) | MET | BOTH.
# FLP writes to FLP_SHEET_ID; MET searches the MET_SHEET_ID tabs.
EVENT_POINT_TARGET=FLP

OFFENSE_SHEET_ID=
PENAL_SHEET_ID=

# Read access to the quota / MET database sheet (the webhook above is the write
# path; this is what lets the site READ rows for the quota check + db sync).
GOOGLE_SERVICE_ACCOUNT_JSON=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

IMPORT_GUILD_ID=
MEDIA_STORAGE_LIMIT_MB=
BODY_LIMIT=256mb

# ── Support help desk (/support) ──────────────────────────────────────
# The ticket web app + METAdministration intake. Intake is RULE-BASED for now
# (no AI key needed). These are reserved for a future AI-powered intake that can
# draw on the MET Policing Handbook + Disciplinary Infraction List:
AI_PROVIDER=      # e.g. anthropic | openai (unused while intake is rule-based)
AI_MODEL=         # e.g. claude-sonnet-5
AI_API_KEY=
# Attachments reuse the existing Media storage; no extra config needed. Realtime
# uses in-process SSE (fine for a single Railway instance; multi-instance would
# need Redis pub/sub).

# ── IP intelligence (VPN detection for the Dev Security Center) ──────────
# IPs are shown ONLY to developers in the security panel. Each account's most
# recent REAL (non-VPN) IP is tracked, and VPN/proxy/datacenter sessions are
# flagged. Detection is best-effort: with a free proxycheck.io key it's
# authoritative; without one it falls back to a free ISP-name heuristic
# (ipwho.is). Leave blank to use the free fallback.
PROXYCHECK_API_KEY=

# ── AI detection for final exams (markers "Scan for AI") ────────────────
# Markers run a cadet's written answers through several AI-text detectors; the
# scores are averaged (no single tool is trusted alone) and the sentences each
# tool flags are highlighted. Two FREE detectors run out of the box with no key:
#   • ZeroGPT   (api.zerogpt.com) — free, no key; gives an AI % + AI sentences.
#   • Heuristic (local)           — offline burstiness / AI-phrase analysis.
# Set AIDETECT_DISABLE_ZEROGPT=true to turn ZeroGPT off.
AIDETECT_DISABLE_ZEROGPT=
# Optional extra detectors — activate only when their key is set:
SAPLING_API_KEY=          # sapling.ai   (free tier)
GPTZERO_API_KEY=          # gptzero.me
WINSTON_API_KEY=          # gowinston.ai
# Generic detector slots — plug in any other API without code changes:
#   AIDETECT_URL, AIDETECT_KEY, AIDETECT_NAME, AIDETECT_AUTH (bearer|x-api-key|none),
#   AIDETECT_FIELD (JSON body field for the text, default "text"). Same with AIDETECT2_*.
AIDETECT_URL=
AIDETECT_KEY=
AIDETECT_NAME=
AIDETECT_AUTH=
AIDETECT_FIELD=

# ── Exam / tryout-log delivery fallbacks + review rank ──────────────────
# If FINAL_EXAM_WEBHOOK isn't set (or fails), post exam results via the bot to
# this channel instead. Same idea for tryout logs.
FINAL_EXAM_CHANNEL_ID=
HPC_TRYOUT_LOG_CHANNEL_ID=
CID_TRYOUT_LOG_CHANNEL_ID=
# HPC group rank (number) at/above which a member can MARK final exams and
# REVIEW HPC tryout logs. Default 247.
HPC_REVIEW_MIN_RANK=247

# ── Sign in with Roblox (Roblox OAuth 2.0 / OIDC) ───────────────────────
# Optional. Register an OAuth app at https://create.roblox.com/dashboard/credentials
# with redirect URI <PUBLIC_BASE_URL>/auth/roblox/callback and scopes "openid
# profile". Signing in with Roblox resolves the user's Discord automatically
# (their linked account → no RoVer call; otherwise RoVer's reverse lookup).
# Leave blank to hide/disable the Roblox sign-in button.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=

# Discord server the final-exam role lives in, if it's NOT the dashboard's primary
# DISCORD_GUILD_ID. Eligibility (needing to sit the exam) is checked LIVE against
# this server's role holders. Defaults to DISCORD_GUILD_ID.
MET_GUILD_ID=

# ── Paid permissions (MET-server Discord roles) ────────────────────────
# Whether a member has any paid permission is read from these MET-server roles
# (NOT the Roblox perms group). Holding none hides the profile Permissions
# section entirely.
MEDIA_PERMS_ROLE_ID=       # "Media"
QUOTA_EXEMPT_ROLE_ID=      # "Quota Exempt" — also lifts the MET weekly quota
MULTIDIV_PERMS_ROLE_ID=    # "Multi Divisional Permissions"
GANG_PERMS_ROLD_ID=        # "Gang Permissions" (env name kept as configured)

# ══════════════════════════════════════════════════════════════════════
# CAD — Metropolitan Police dispatch system (Discord radio + voice + web
# console). ALL optional: with none of these set, CAD is dormant. The web
# console (dev panel → CAD Dispatch) works as soon as the DB is migrated;
# the Discord radio channel + TTS voice come online when configured.
# ══════════════════════════════════════════════════════════════════════
# Guild the CAD operates in (defaults to DISCORD_GUILD_ID).
CAD_GUILD_ID=
# #radio text channel — officers type free-text transmissions here; the intent
# parser reads them. Setting this ALSO enables the Message Content intent.
CAD_RADIO_CHANNEL_ID=
# Voice channel the dispatcher voice joins to speak transmissions (TTS).
CAD_VOICE_CHANNEL_ID=
# Role pinged on urgent-assistance / Grade I broadcasts (control room).
CAD_CONTROL_ROLE_ID=
# Local mp3 played before a Grade I transmission (attention tone). Optional.
CAD_ATTENTION_TONE_PATH=
# Intent parser (radio free-text → structured intent). With no key it falls
# back to a deterministic rule-based parser, so the radio still works.
ANTHROPIC_API_KEY=
CAD_INTENT_MODEL=claude-sonnet-5
CAD_INTENT_MIN_CONFIDENCE=0.6
# ElevenLabs TTS (en-GB dispatcher voice). Set the API key to enable speech;
# the voice defaults to a British dispatcher voice (Daniel) — override with
# ELEVENLABS_VOICE_ID. Actual playback also needs CAD_VOICE_CHANNEL_ID + the
# optional audio deps (see docs/CAD.md). With no key, CAD is text-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ── External voice worker ────────────────────────────────────────────────────
# Discord voice needs outbound UDP, which Railway does NOT route — so in-process
# voice joins but never speaks. Deploy the standalone worker in voice-worker/ to
# a UDP-capable host (see voice-worker/README.md). Two ways to link it:
#
# 1. GATEWAY mode (recommended; works on free bot hosts with no inbound URL):
#    set ONLY CAD_VOICE_WORKER_SECRET here. The worker dials IN to this app over
#    WebSocket at /cad-voice using that same secret. Nothing else needed.
#
# 2. HTTP mode (host with a public URL, e.g. Fly.io): also set
#    CAD_VOICE_WORKER_URL to the worker's URL; this app calls it directly.
#
# Set the same secret on the worker as WORKER_SECRET.
CAD_VOICE_WORKER_SECRET=
CAD_VOICE_WORKER_URL=

# ── MET emoji ─────────────────────────────────────────────────────────
# The MET emoji set (scripts/emoji/manifest.js → the PNGs in
# client/public/img/emoji) is uploaded to the BOT APPLICATION on startup, not to
# a server. An application emoji belongs to the bot, so it renders in DMs, in
# servers where the bot was never given emoji permissions, and in every embed
# the bot sends anywhere — none of which a guild emoji does. 2000 slots, and no
# "Manage Expressions" to chase. Nothing to configure.
#
# They are NEVER uploaded into the MET server. If the application route is
# unavailable, nothing is uploaded at all and e() falls back to the unicode
# character the emoji replaced — filling 50 of a server's slots with marks only
# the bot uses is not a recovery.
#
# EMOJI_STORE=guild opts back into uploading them into a server, for a
# deployment that genuinely wants that; EMOJI_GUILD_ID picks which one (blank →
# MET_GUILD_ID → DISCORD_GUILD_ID). Neither is needed normally.
#
# EMOJI_PURGE_GUILD=1 deletes copies still sitting in a server from before these
# moved to the bot. Only emoji whose name is EXACTLY one of ours are touched —
# the server's own rank badges (:CON:, :SGT:, :CINS: …) are never at risk, and
# the rank displays depend on them. Without it, strays are only reported.
# POST /api/dev/emoji/purge-guild does the same on demand (dry run by default).
#
# Either way it degrades rather than breaks. GET /api/dev/emoji shows which are
# live and where they live.
EMOJI_GUILD_ID=
EMOJI_STORE=
EMOJI_PURGE_GUILD=

# ── /discipline ───────────────────────────────────────────────────────
# Guild the /discipline slash command is registered in. Should be the server
# holding the ROLE_STRIKE_* / ROLE_* punishment roles above. Blank →
# DISCORD_GUILD_ID.
DISCIPLINE_GUILD_ID=

# Who may run it. Internal Affairs (the site role) and Deputy Commissioner and
# above (the MET group rank, via METHICOMM_MIN_RANK / METHICOMM_ROLE_ID) are
# always allowed. These are extra Discord roles that also count as IA — useful
# for IA members who have never logged into the dashboard. Comma-separated.
IA_COMMAND_ROLE_IDS=

# Punishment roles are re-applied when a member leaves and rejoins the server,
# so leaving is not a way to shed a strike. Only roles for punishments that are
# still active (not expired, not lifted, not appealed) come back.
# Set to `off` to disable.
PUNISHMENT_REAPPLY=

# ── XP ────────────────────────────────────────────────────────────────
# Where /xp is registered. Blank → DISCORD_GUILD_ID.
XP_GUILD_ID=

# Where every XP change and promotion is posted. Defaults to the MET XP-logs
# channel; the bot must be able to post there.
XP_LOG_CHANNEL_ID=1531317662360146092

# Who may CHANGE XP: the FLP officer role below, anyone with Administrator in
# the server, or Deputy Commissioner and above in the MET group. Internal
# Affairs on its own is NOT enough. Anyone can VIEW XP.
FLP_OFFICER_ROLE_ID=1431554710594388018

# Extra Discord roles that may also change XP — trainers, event hosts, anyone
# who should award XP without disciplinary powers. Comma-separated.
XP_MANAGER_ROLE_IDS=

# The XP totals each rank needs. Blank uses the defaults:
#   CON=2, SGT=15, INS=40, CINS=100  (Community Support Officer is the 0 floor)
# These are TOTALS, not costs — an officer on 15 XP is a Sergeant. Rank is
# derived from the balance, so changing a number here re-ranks everybody
# immediately with no backfill.
#
# The top rung is also the CEILING: 100 XP is the most anybody can hold, since
# XP exists to promote people up to Chief Inspector and there is nothing above
# it to earn towards. Raising CINS here raises the ceiling with it.
XP_THRESHOLDS=

# Crossing a threshold moves the officer's MET Roblox group rank to match --
# up on a promotion, down on a demotion. Set to `off` to announce and DM the
# change but leave the group alone.
#
# A demotion never touches somebody ranked ABOVE the ladder (Superintendent and
# up). XP tops out at Chief Inspector, so demoting them would be a system
# ranking people it has no business ranking. Their XP still moves.
XP_GROUP_PROMOTE=

# What signing off a patrol or event log is worth. These are the FLP rules:
#
#   PATROL_XP_MINUTES   one XP per this many COMPLETED minutes of patrol.
#                       30 → half an hour is 1 XP, an hour is 2, an hour and a
#                       half is 3. Part-finished blocks pay nothing.
#   EVENT_ATTENDEE_XP   XP each attendee gets for an event. One event is worth
#                       1 XP, alongside the one MET database point the same
#                       attendance is worth (EVENT_ATTENDEE_POINTS).
#
# The host gets no XP for their own event — hosting already pays a point on the
# FLP database (EVENT_HOST_POINTS).
PATROL_XP_MINUTES=30
EVENT_ATTENDEE_XP=1

# ── Slash commands ────────────────────────────────────────────────────
# /discipline and /xp are registered in MET_GUILD_ID *and* DISCORD_GUILD_ID
# (deduplicated). If those are different servers, both get them — who may
# actually run a command is decided in code, not by where it appears, so an
# extra registration costs nothing and removes a whole class of "the command
# isn't there".
#
# If the commands don't show up:
#   1. GET /api/dev/commands  — what Discord actually has, and in which servers
#   2. POST /api/dev/commands/register — re-register without a restart
#   3. "Missing Access" in the logs means the bot was invited WITHOUT the
#      applications.commands scope. Re-invite it with that scope ticked; its
#      roles, messages and members are unaffected.
#
# Set to 1 to ALSO register them globally (every server the bot is in). Global
# commands take up to an hour to propagate, so this is a fallback rather than a
# default — it happens automatically anyway if no guild registration succeeds.
REGISTER_GLOBAL_COMMANDS=

# ── Internal Affairs event logs ───────────────────────────────────────
# Filing an IA event pays every attendee, on both systems at once:
#   IA_EVENT_POINTS   quota points each, on the IA database
#   IA_EVENT_XP       XP each, on MET — the same currency /xp moves and
#                     promotions are driven by. 0 turns the XP half off.
# The host is never on their own roll. Only supervisors and above may file one:
# there is no approval step, so filing IS the award.
IA_EVENT_POINTS=2
IA_EVENT_XP=2

# ── Leave of absence ──────────────────────────────────────────────────
# /loa lives entirely in Discord — request, active, admin, history, manage,
# pending. There is no page for it.
#
#   LOA_ADMIN_ROLE_ID  the role that decides. Nothing is ever auto-approved.
#                      Defaults to Jade Command.
#   LOA_CHANNEL_ID     where a request card is posted for review. The card is
#                      edited in place when it is decided, and every later
#                      change replies to it, so one request reads as one thread
#                      and the channel never carries a stale "pending" message.
#                      Defaults to the MET loa-requests channel.
#   LOA_MAX_DAYS       the soft ceiling in days (default 14). Longer is not
#                      refused, it is FLAGGED, so granting it is a decision
#                      rather than an oversight. 90 days is the hard stop.
#   LOA_GUILD_ID       extra guild to register /loa in, on top of the MET one.
LOA_ADMIN_ROLE_ID=1422406753231966290
LOA_CHANNEL_ID=1499804454906630217
LOA_MAX_DAYS=14
LOA_GUILD_ID=

# ── The weekly IA quota review ────────────────────────────────────────
# Posted automatically rather than by somebody remembering to: every member's
# points against their target, and Investigator of the Week picked as whoever
# scored highest. A tie wins nobody — the post says so and leaves the choice to
# High Command. It goes to the same channel the manual submit does.
#
# It runs once per week, stamped by ISO week, so a restart cannot post it twice
# and a server that was down at the time still posts it when it comes back.
QUOTA_WEEKLY_AUTO=            # 'off' to disable and leave it to a person
QUOTA_WEEKLY_DAY=0            # 0 = Sunday
QUOTA_WEEKLY_HOUR=23
QUOTA_WEEKLY_MINUTE=59

{
  "name": "metsite",
  "version": "1.0.0",
  "description": "Metropolitan Police Service Portal — CID, SCO-19, Internal Affairs, FLP, Hendon Police College",
  "main": "server/index.js",
  "scripts": {
    "start": "prisma db push --skip-generate --accept-data-loss && node server/index.js",
    "start:raw": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "import:cases": "node scripts/import-forum-cases.js",
    "discover:divisions": "node scripts/discover-divisions.js",
    "test": "node --test test/cad/units.service.test.js test/cad/dispatch.service.test.js",
    "test:cad": "node --test test/cad/units.service.test.js test/cad/dispatch.service.test.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@simplewebauthn/server": "^10.0.1",
    "cookie-parser": "^1.4.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^140.0.1",
    "javascript-obfuscator": "^4.2.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "prisma": "^5.10.0",
    "qrcode": "^1.5.4",
    "terser": "^5.31.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "//optionalDependencies": "CAD voice (TTS into a voice channel). Optional so a native-build failure can never break `npm install`; the CAD runs text-only until these are present. Install with: npm i @discordjs/voice opusscript libsodium-wrappers ffmpeg-static",
  "optionalDependencies": {
    "@discordjs/voice": "^0.17.0",
    "opusscript": "^0.1.1",
    "libsodium-wrappers": "^0.7.13",
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

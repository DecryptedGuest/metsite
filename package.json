{
  "name": "metsite",
  "version": "1.0.0",
  "description": "Metropolitan Police Service Portal — CID, SCO-19, Internal Affairs, FLP, Hendon Police College",
  "main": "server/index.js",
  "scripts": {
    "start": "prisma db push --skip-generate --accept-data-loss && node server/index.js",
    "start:raw": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "import:cases": "node scripts/import-forum-cases.js",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cookie-parser": "^1.4.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "prisma": "^5.10.0",
    "terser": "^5.31.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
